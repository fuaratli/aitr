---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import AdSlot from '../components/AdSlot.astro';
import ProgressBar from '../components/ProgressBar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SocialShare from '../components/SocialShare.astro';
import AuthorCard from '../components/AuthorCard.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import HeroCover from '../components/HeroCover.astro';
import StickyToc from '../components/StickyToc.astro';
import ArticleFeedback from '../components/ArticleFeedback.astro';
import BookmarkButton from '../components/BookmarkButton.astro';
import { SITE_LANG, SITE_TITLE, SITE_AUTHOR } from '../consts';
import { CATEGORY_META, type CategoryKey } from '../lib/categories';
import { slugifyTag } from '../lib/slug';

type Props = CollectionEntry<'blog'>['data'] & {
	slug?: string;
	headings?: MarkdownHeading[];
	minutes?: number;
	related?: CollectionEntry<'blog'>[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	tags = [],
	slug = '',
	headings = [],
	minutes,
	related = [],
} = Astro.props;

const categoryMeta = category ? CATEGORY_META[category as CategoryKey] : null;
const h2s = headings.filter((h) => h.depth === 2);
const articleUrl = Astro.url.toString();

const breadcrumbs = [
	{ label: 'Anasayfa', href: '/' },
	{ label: 'Yazılar', href: '/blog/' },
	...(categoryMeta
		? [{ label: categoryMeta.label, href: `/blog/kategori/${categoryMeta.slug}/` }]
		: []),
	{ label: title },
];

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	author: { '@type': 'Person', name: SITE_AUTHOR },
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', Astro.site).toString() },
	},
	mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
};
---

<html lang={SITE_LANG}>
	<head>
		<BaseHead
			title={title}
			description={description}
			pubDate={pubDate}
			updatedDate={updatedDate}
			type="article"
		/>
		<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} is:inline />
	</head>

	<body>
		<ProgressBar />
		<Header />
		<main class="post-main">
			<Breadcrumbs items={breadcrumbs} />
			<article>
				<header class="post-header">
					<div class="mesh-bg" aria-hidden="true"></div>
					<div class="meta">
						{
							categoryMeta && (
								<a class="cat-pill" href={`/blog/kategori/${categoryMeta.slug}/`} style={`background:${categoryMeta.gradient}`}>
									{categoryMeta.emoji} {categoryMeta.label}
								</a>
							)
						}
						<span class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<>
										<span class="sep">·</span>
										<span class="updated">
											güncel: <FormattedDate date={updatedDate} />
										</span>
									</>
								)
							}
						</span>
						{
							minutes && (
								<span class="read-time">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<circle cx="12" cy="12" r="10" />
										<polyline points="12 6 12 12 16 14" />
									</svg>
									{minutes} dk okuma
								</span>
							)
						}
					</div>
					<h1>{title}</h1>
					<p class="lede">{description}</p>
					{slug && (
						<div class="header-actions">
							<BookmarkButton slug={slug} title={title} variant="inline" />
						</div>
					)}
				</header>

				<div class="hero-image">
					{
						heroImage ? (
							<Image width={1200} height={600} src={heroImage} alt={title} />
						) : (
							<HeroCover title={title} category={category} size="large" />
						)
					}
				</div>

				<div class="ad-top">
					<AdSlot size="leaderboard" label="Reklam" slot="post-top" />
				</div>

				{
					h2s.length > 2 && (
						<nav class="toc" aria-label="İçindekiler">
							<h3>📑 İçindekiler</h3>
							<ol>
								{h2s.map((h) => (
									<li>
										<a href={`#${h.slug}`}>{h.text}</a>
									</li>
								))}
							</ol>
						</nav>
					)
				}

				<StickyToc headings={headings} />

				<div class="prose">
					<slot />
				</div>

				{
					tags.length > 0 && (
						<div class="tags-row" aria-label="Etiketler">
							<span class="tags-label">Etiketler:</span>
							{tags.map((t) => (
								<a class="tag-pill" href={`/etiket/${slugifyTag(t)}/`}>
									#{t}
								</a>
							))}
						</div>
					)
				}

				<div class="share-row">
					<SocialShare url={articleUrl} title={title} />
				</div>

				<div class="ad-bottom">
					<AdSlot size="banner" label="Reklam" slot="post-bottom" />
				</div>

				{slug && <ArticleFeedback slug={slug} />}

				<AuthorCard />

				<NewsletterSignup variant="inline" />

				<footer class="post-footer">
					<a class="btn btn-ghost" href="/blog">← Tüm yazılar</a>
					{
						categoryMeta && (
							<a class="btn btn-primary" href={`/blog/kategori/${categoryMeta.slug}/`}>
								{categoryMeta.label} →
							</a>
						)
					}
				</footer>
			</article>

			<RelatedArticles posts={related} />
		</main>
		<Footer />

		<style>
			.post-main {
				max-width: 100%;
				padding: 0;
				margin: 0;
			}
			.post-header {
				position: relative;
				overflow: hidden;
				padding: 3em 1.25em 2em;
				text-align: center;
				border-bottom: 1px solid var(--border);
			}
			.post-header > *:not(.mesh-bg) {
				position: relative;
				z-index: 2;
			}
			.meta {
				display: inline-flex;
				align-items: center;
				gap: 0.85em;
				flex-wrap: wrap;
				justify-content: center;
				margin-bottom: 1.25em;
			}
			.cat-pill {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				padding: 0.4em 0.95em;
				border-radius: 999px;
				color: white;
				font-weight: 600;
				font-size: 0.85em;
				text-decoration: none;
				box-shadow: var(--glow-violet);
				transition: 0.2s ease;
			}
			.cat-pill:hover {
				transform: translateY(-1px);
				color: white;
			}
			.meta .date {
				color: var(--text-muted);
				font-size: 0.9em;
			}
			.meta .sep {
				margin: 0 0.4em;
				color: var(--text-dim);
			}
			.meta .updated {
				font-style: italic;
			}
			.read-time {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				color: var(--text-muted);
				font-size: 0.9em;
			}
			.post-header h1 {
				font-size: clamp(2em, 5vw, 3.2em);
				max-width: 900px;
				margin: 0 auto 0.5em;
				letter-spacing: -0.03em;
				line-height: 1.15;
			}
			.lede {
				font-size: 1.15em;
				color: var(--text-muted);
				max-width: 720px;
				margin: 0 auto;
				line-height: 1.6;
			}
			.hero-image {
				max-width: 1100px;
				margin: 2em auto 0;
				padding: 0 1.25em;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 16px;
				border: 1px solid var(--border);
			}
			.ad-top,
			.ad-bottom {
				max-width: 760px;
				margin: 1.5em auto;
				padding: 0 1.25em;
			}
			.toc {
				max-width: 760px;
				margin: 2em auto 0;
				padding: 1.25em 1.5em;
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: 12px;
				color: var(--text-muted);
			}
			.toc h3 {
				margin: 0 0 0.5em 0;
				font-size: 1em;
				color: var(--text);
				font-family: var(--font-display);
			}
			.toc ol {
				margin: 0;
				padding-left: 1.25em;
			}
			.toc li {
				margin: 0.35em 0;
			}
			.toc a {
				color: var(--text-muted);
				text-decoration: none;
				transition: 0.15s ease;
				border-bottom: 1px solid transparent;
			}
			.toc a:hover {
				color: #c4b5fd;
				border-bottom-color: rgba(196, 181, 253, 0.3);
			}
			.prose {
				max-width: 760px;
				margin: 0 auto;
				padding: 2em 1.25em;
				font-size: 1.08em;
				line-height: 1.8;
			}
			.prose :global(h2) {
				scroll-margin-top: 80px;
			}
			.prose :global(h3) {
				scroll-margin-top: 80px;
			}
			.share-row {
				max-width: 760px;
				margin: 1em auto;
				padding: 0 1.25em;
				text-align: center;
			}
			.header-actions {
				margin-top: 1em;
				display: flex;
				justify-content: center;
				gap: 0.5em;
				flex-wrap: wrap;
			}
			.tags-row {
				max-width: 760px;
				margin: 1.5em auto 0.5em;
				padding: 0 1.25em;
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				align-items: center;
			}
			.tags-label {
				font-size: 0.85em;
				color: var(--text-dim);
				margin-right: 0.4em;
			}
			.tag-pill {
				display: inline-block;
				padding: 0.35em 0.8em;
				background: var(--surface);
				color: var(--text-muted);
				border: 1px solid var(--border);
				border-radius: 999px;
				text-decoration: none;
				font-size: 0.82em;
				font-weight: 500;
				transition: 0.15s ease;
			}
			.tag-pill:hover {
				background: var(--gradient-1);
				color: white;
				border-color: transparent;
				transform: translateY(-1px);
			}
			.post-footer {
				max-width: 760px;
				margin: 0 auto;
				padding: 1em 1.25em 2em;
				display: flex;
				justify-content: space-between;
				gap: 1em;
				flex-wrap: wrap;
			}
			@media (max-width: 720px) {
				.post-header {
					padding: 2em 1em 1.5em;
				}
				.lede {
					font-size: 1em;
				}
				.prose {
					padding: 1.5em 1em;
					font-size: 1.02em;
				}
				.post-footer {
					padding: 1em 1em 2em;
				}
			}
		</style>
	</body>
</html>
