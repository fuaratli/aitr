---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_LANG, SITE_TITLE } from '../consts';

const pageTitle = `İletişim — ${SITE_TITLE}`;
const pageDescription =
	'AITR ile iletişime geç. Öneri, soru, iş birliği teklifleri ve geri bildirimlerin için yazabilirsin.';

const breadcrumbs = [
	{ label: 'Anasayfa', href: '/' },
	{ label: 'İletişim' },
];
---

<!doctype html>
<html lang={SITE_LANG}>
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body>
		<Header />
		<main class="contact-main">
			<Breadcrumbs items={breadcrumbs} />
			<header class="hero">
				<div class="mesh-bg" aria-hidden="true"></div>
				<div class="inner">
					<span class="pill pill-glow">İletişim</span>
					<h1>Yazışmak için <span class="gradient-text">buradayız</span></h1>
					<p class="lede">
						Öneri, soru, iş birliği teklifi ya da düzeltme — her şeyi okuyoruz. Mümkün olduğunca
						hızlı dönmeye çalışıyoruz.
					</p>
				</div>
			</header>

			<section class="grid">
				<aside class="info">
					<h2>Direkt iletişim</h2>
					<p>
						Genel sorular ve geri bildirimler için:<br />
						<a href="mailto:merhaba@aitr.example">merhaba@aitr.example</a>
					</p>
					<h2>Reklam ve iş birliği</h2>
					<p>
						Sponsorlu içerik, ürün incelemesi veya partner teklifi için:<br />
						<a href="mailto:isbirligi@aitr.example">isbirligi@aitr.example</a>
					</p>
					<h2>Editörlüğe öneri</h2>
					<p>
						Yazılmasını istediğin bir konu, düzeltme önerisi veya hatalı bilgi tespit ettiysen
						bize yaz. Editörlük takımımız her öneriyi değerlendirir.
					</p>
					<h2>Yanıt süresi</h2>
					<p>
						Hafta içi 24 saat, hafta sonu 48 saat içinde dönüyoruz. Reklam teklifleri biraz daha
						uzun sürebilir.
					</p>
				</aside>

				<form class="form" data-contact-form>
					<label>
						<span>Ad Soyad</span>
						<input type="text" name="name" required placeholder="Adın" autocomplete="name" />
					</label>
					<label>
						<span>E-posta</span>
						<input type="email" name="email" required placeholder="senin@email.com" autocomplete="email" />
					</label>
					<label>
						<span>Konu</span>
						<select name="subject" required>
							<option value="">Konu seç</option>
							<option value="oneri">Öneri / geri bildirim</option>
							<option value="duzeltme">Hata bildirimi</option>
							<option value="isbirligi">İş birliği / reklam</option>
							<option value="diger">Diğer</option>
						</select>
					</label>
					<label>
						<span>Mesajın</span>
						<textarea name="message" rows="6" required placeholder="Bize anlatmak istediklerini yaz..."></textarea>
					</label>
					<p class="privacy-note">
						Form gönderildiğinde bilgilerin yalnızca yanıt verme amacıyla kullanılır.
						<a href="/gizlilik/">Gizlilik Politikası</a>
					</p>
					<button type="submit" class="submit">
						Mesajı Gönder
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
					</button>
				</form>
			</section>
		</main>
		<Footer />

		<style>
			.contact-main {
				max-width: 100%;
				padding: 0;
			}
			.hero {
				position: relative;
				overflow: hidden;
				padding: 3.5em 1.25em 2em;
				text-align: center;
				border-bottom: 1px solid var(--border);
			}
			.hero .inner {
				position: relative;
				z-index: 2;
				max-width: 720px;
				margin: 0 auto;
			}
			.hero .pill {
				margin-bottom: 1em;
			}
			.hero h1 {
				font-size: clamp(2em, 5vw, 3em);
				margin: 0 0 0.4em 0;
				letter-spacing: -0.03em;
			}
			.lede {
				color: var(--text-muted);
				font-size: 1.05em;
				margin: 0;
			}
			.grid {
				max-width: 1100px;
				margin: 0 auto;
				padding: 3em 1.25em;
				display: grid;
				grid-template-columns: 1fr 1.4fr;
				gap: 3em;
			}
			.info h2 {
				font-size: 1em;
				font-family: var(--font-display);
				color: var(--text);
				margin: 0 0 0.4em 0;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				font-size: 0.85em;
				color: var(--text-dim);
			}
			.info p {
				color: var(--text-muted);
				margin: 0 0 1.5em 0;
				line-height: 1.6;
				font-size: 0.95em;
			}
			.info a {
				color: #c4b5fd;
				text-decoration: none;
				border-bottom: 1px solid rgba(196, 181, 253, 0.3);
			}
			.info a:hover {
				color: #f9a8d4;
			}
			.form {
				display: flex;
				flex-direction: column;
				gap: 1em;
				padding: 1.75em;
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: 16px;
			}
			.form label {
				display: flex;
				flex-direction: column;
				gap: 0.4em;
				font-size: 0.85em;
				color: var(--text-muted);
				font-weight: 500;
			}
			.form input,
			.form select,
			.form textarea {
				width: 100%;
				padding: 0.8em 1em;
				background: rgba(7, 7, 13, 0.5);
				border: 1px solid var(--border-2);
				border-radius: 10px;
				color: var(--text);
				font-size: 0.95em;
				font-family: inherit;
				resize: vertical;
			}
			:global([data-theme='light']) .form input,
			:global([data-theme='light']) .form select,
			:global([data-theme='light']) .form textarea {
				background: rgba(255, 255, 255, 0.7);
			}
			.form input:focus,
			.form select:focus,
			.form textarea:focus {
				outline: none;
				border-color: var(--accent);
				box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.2);
			}
			.privacy-note {
				font-size: 0.8em;
				color: var(--text-dim);
				margin: 0;
			}
			.privacy-note a {
				color: #c4b5fd;
			}
			.submit {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.5em;
				padding: 0.85em 1.5em;
				background: var(--gradient-1);
				color: white;
				border: none;
				border-radius: 10px;
				font-weight: 700;
				font-family: var(--font-display);
				font-size: 0.95em;
				cursor: pointer;
				box-shadow: var(--glow-violet);
				transition: 0.2s ease;
			}
			.submit:hover {
				transform: translateY(-1px);
				box-shadow: 0 0 50px rgba(139, 92, 246, 0.6);
			}
			.success-msg {
				background: linear-gradient(135deg, rgba(34, 197, 94, 0.15), rgba(34, 197, 94, 0.05));
				border: 1px solid rgba(34, 197, 94, 0.4);
				color: #4ade80;
				padding: 1em 1.25em;
				border-radius: 12px;
				margin: 0;
			}
			@media (max-width: 820px) {
				.grid {
					grid-template-columns: 1fr;
					gap: 2em;
				}
			}
		</style>

		<script is:inline>
			(function () {
				function setupContact() {
					document.querySelectorAll('[data-contact-form]').forEach(function (form) {
						if (form.dataset.bound) return;
						form.dataset.bound = '1';
						form.addEventListener('submit', function (e) {
							e.preventDefault();
							var subject = encodeURIComponent('AITR İletişim — ' + (form.subject.value || 'Mesaj'));
							var body = encodeURIComponent(
								'Ad: ' + form.name.value + '\n' +
								'E-posta: ' + form.email.value + '\n' +
								'Konu: ' + form.subject.value + '\n\n' +
								'Mesaj:\n' + form.message.value
							);
							window.location.href = 'mailto:merhaba@aitr.example?subject=' + subject + '&body=' + body;
							setTimeout(function () {
								form.innerHTML =
									'<p class="success-msg">✓ Teşekkürler! E-posta uygulaman açıldı — gönderdikten sonra en kısa sürede döneceğiz.</p>';
							}, 600);
						});
					});
				}
				document.addEventListener('astro:page-load', setupContact);
			})();
		</script>
	</body>
</html>
