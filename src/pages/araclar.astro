---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE_LANG, SITE_TITLE } from '../consts';

const pageTitle = `AI Araçları Dizini — ${SITE_TITLE}`;
const pageDescription =
	"En iyi yapay zeka araçları, kategorize edilmiş ve dürüst yorumlanmış. ChatGPT'den Suno'ya 30+ aracı tek sayfada keşfet.";

const breadcrumbs = [
	{ label: 'Anasayfa', href: '/' },
	{ label: 'AI Araçları Dizini' },
];

type Tool = {
	name: string;
	desc: string;
	tag: string;
	free: 'tam' | 'kısmi' | 'yok';
	link?: string;
};

const tools: { category: string; emoji: string; gradient: string; items: Tool[] }[] = [
	{
		category: 'Sohbet & Yazım',
		emoji: '💬',
		gradient: 'linear-gradient(135deg,#8b5cf6,#ec4899)',
		items: [
			{ name: 'ChatGPT', desc: 'OpenAI\'nin amiral gemisi. Genel sohbet, kod, görsel.', tag: 'En dengeli', free: 'kısmi', link: '/blog/chatgpt-claude-gemini-karsilastirma-2026/' },
			{ name: 'Claude', desc: 'Anthropic. Türkçe yazımda en iyilerden. Uzun belge analizi.', tag: 'En iyi yazım', free: 'kısmi', link: '/blog/chatgpt-claude-gemini-karsilastirma-2026/' },
			{ name: 'Gemini', desc: 'Google ekosistemine bütünleşik. Çok uzun bağlam (2M token).', tag: 'En uzun bağlam', free: 'kısmi', link: '/blog/chatgpt-claude-gemini-karsilastirma-2026/' },
			{ name: 'Perplexity', desc: 'Kaynaklı cevap. Araştırma için ideal.', tag: 'Kaynak verir', free: 'kısmi' },
			{ name: 'DeepSeek', desc: 'Açık kaynak Çin modeli. Çok ucuz API.', tag: 'En ucuz API', free: 'tam', link: '/blog/deepseek-incelemesi-chatgpt-rakibi-mi/' },
			{ name: 'Mistral Le Chat', desc: 'AB tabanlı. Hızlı, veri Avrupa\'da.', tag: 'AB veri', free: 'tam' },
		],
	},
	{
		category: 'Görsel Üretimi',
		emoji: '🎨',
		gradient: 'linear-gradient(135deg,#3b82f6,#8b5cf6)',
		items: [
			{ name: 'Midjourney', desc: 'En estetik. İllüstrasyon, konsept sanat.', tag: 'En estetik', free: 'yok', link: '/blog/midjourney-turkce-rehber-2026/' },
			{ name: 'DALL·E 3', desc: 'ChatGPT içinde. Yazı içeren görsellerde iyi.', tag: 'En akıllı prompt', free: 'kısmi', link: '/blog/ai-gorsel-ureticiler-karsilastirma-2026/' },
			{ name: 'Stable Diffusion', desc: 'Açık kaynak, tam kontrol. Civitai modelleri.', tag: 'Açık kaynak', free: 'tam' },
			{ name: 'Flux', desc: 'Black Forest Labs. Fotoğrafik gerçekçilik şampiyonu.', tag: 'En gerçekçi', free: 'kısmi' },
			{ name: 'Ideogram', desc: 'Yazılı görsel için en iyi.', tag: 'Yazı için', free: 'kısmi' },
			{ name: 'Leonardo.ai', desc: 'Günde 150 ücretsiz kredi. Oyun art için iyi.', tag: 'Cömert ücretsiz', free: 'tam' },
			{ name: 'Microsoft Designer', desc: 'DALL·E 3 tamamen ücretsiz erişim.', tag: 'Ücretsiz DALL·E', free: 'tam' },
		],
	},
	{
		category: 'Video & Ses',
		emoji: '🎬',
		gradient: 'linear-gradient(135deg,#06b6d4,#3b82f6)',
		items: [
			{ name: 'Runway', desc: 'Gen-3 Alpha video AI. Endüstri lideri.', tag: 'Video lideri', free: 'kısmi' },
			{ name: 'Pika Labs', desc: 'Hızlı kısa videolar. Sosyal medya odaklı.', tag: 'Hızlı', free: 'kısmi' },
			{ name: 'ElevenLabs', desc: 'Ses kloncuma. Türkçe çok iyi.', tag: 'En iyi ses', free: 'kısmi' },
			{ name: 'Suno', desc: 'Tam şarkı üretici. Şaşırtıcı kaliteli.', tag: 'Müzik üretici', free: 'kısmi' },
			{ name: 'Udio', desc: 'Suno\'nun rakibi. Daha temiz audio.', tag: 'Alternatif', free: 'kısmi' },
			{ name: 'CapCut', desc: 'Ücretsiz video editör + AI özellikler.', tag: 'Tam ücretsiz', free: 'tam' },
		],
	},
	{
		category: 'Yazılım & Kod',
		emoji: '💻',
		gradient: 'linear-gradient(135deg,#ec4899,#f97316)',
		items: [
			{ name: 'Cursor', desc: 'VS Code üzerine kurulu AI IDE. Yeni standart.', tag: 'Geliştiriciler için', free: 'kısmi' },
			{ name: 'GitHub Copilot', desc: 'GitHub\'ın AI asistanı. Free tier mevcut.', tag: 'Resmi GitHub', free: 'kısmi' },
			{ name: 'Windsurf', desc: 'Codeium\'un IDE\'si. Cursor rakibi.', tag: 'Cursor alternatifi', free: 'kısmi' },
			{ name: 'Continue.dev', desc: 'Açık kaynak, kendi API anahtarınla.', tag: 'Açık kaynak', free: 'tam' },
			{ name: 'Cody', desc: 'Sourcegraph\'ın AI kod asistanı.', tag: 'Enterprise', free: 'kısmi' },
		],
	},
	{
		category: 'Verimlilik & İş',
		emoji: '📋',
		gradient: 'linear-gradient(135deg,#8b5cf6,#3b82f6)',
		items: [
			{ name: 'Notion AI', desc: 'Notion içinde yapay zeka.', tag: 'Notion entegre', free: 'kısmi' },
			{ name: 'Gamma', desc: 'AI ile sunum, doc, web sitesi.', tag: 'Sunum', free: 'kısmi' },
			{ name: 'NotebookLM', desc: 'Google. PDF analiz, podcast modu.', tag: 'PDF için', free: 'tam' },
			{ name: 'tl;dv', desc: 'Zoom/Meet toplantı özet.', tag: 'Toplantı', free: 'kısmi' },
			{ name: 'Reclaim.ai', desc: 'AI takvim asistanı.', tag: 'Takvim', free: 'kısmi' },
		],
	},
];

const freeLabel = { tam: 'Tamamen ücretsiz', kısmi: 'Ücretsiz + ücretli', yok: 'Sadece ücretli' };
const freeColor = {
	tam: 'linear-gradient(135deg,#22c55e,#16a34a)',
	kısmi: 'linear-gradient(135deg,#8b5cf6,#ec4899)',
	yok: 'linear-gradient(135deg,#f97316,#ef4444)',
};
---

<!doctype html>
<html lang={SITE_LANG}>
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body>
		<Header />
		<main class="tools-main">
			<Breadcrumbs items={breadcrumbs} />
			<header class="hero">
				<div class="mesh-bg" aria-hidden="true"></div>
				<div class="inner">
					<span class="pill pill-glow">Araçlar Dizini</span>
					<h1>30+ Yapay Zeka Aracı, <span class="gradient-text">tek sayfada</span></h1>
					<p class="lede">
						Sohbetten görsel üretimine, kod yazımından müziğe — incelediğimiz tüm AI araçları
						kategorize edilmiş, dürüst değerlendirilmiş ve karşılaştırmalarla bağlantılı.
					</p>
				</div>
			</header>

			<div class="ad-wrap">
				<AdSlot size="leaderboard" label="Reklam" slot="tools-top" />
			</div>

			{
				tools.map((cat) => (
					<section class="cat-section reveal">
						<header class="cat-head">
							<div class="cat-icon" style={`background:${cat.gradient}`}>{cat.emoji}</div>
							<h2>{cat.category}</h2>
						</header>
						<ul class="tool-grid">
							{cat.items.map((tool) => (
								<li class="tool-card">
									{tool.link ? (
										<a href={tool.link}>
											<div class="row">
												<h3>{tool.name}</h3>
												<span class="free-badge" style={`background:${freeColor[tool.free]}`}>{freeLabel[tool.free]}</span>
											</div>
											<p>{tool.desc}</p>
											<span class="tool-tag">{tool.tag}</span>
											<span class="read-cta">İncele →</span>
										</a>
									) : (
										<div class="static-card">
											<div class="row">
												<h3>{tool.name}</h3>
												<span class="free-badge" style={`background:${freeColor[tool.free]}`}>{freeLabel[tool.free]}</span>
											</div>
											<p>{tool.desc}</p>
											<span class="tool-tag">{tool.tag}</span>
										</div>
									)}
								</li>
							))}
						</ul>
					</section>
				))
			}

			<div class="ad-wrap">
				<AdSlot size="banner" label="Reklam" slot="tools-bottom" />
			</div>
		</main>
		<Footer />

		<style>
			.tools-main {
				max-width: 100%;
				padding: 0;
			}
			.hero {
				position: relative;
				overflow: hidden;
				padding: 3.5em 1.25em 2.5em;
				text-align: center;
				border-bottom: 1px solid var(--border);
			}
			.hero .inner {
				position: relative;
				z-index: 2;
				max-width: 760px;
				margin: 0 auto;
			}
			.hero .pill {
				margin-bottom: 1em;
			}
			.hero h1 {
				font-size: clamp(2em, 5vw, 3.2em);
				margin: 0 0 0.5em 0;
				letter-spacing: -0.03em;
			}
			.lede {
				color: var(--text-muted);
				font-size: 1.05em;
				margin: 0;
				line-height: 1.6;
			}
			.ad-wrap {
				display: flex;
				justify-content: center;
				padding: 0 1.25em;
				max-width: 1200px;
				margin: 1em auto;
			}
			.cat-section {
				max-width: 1200px;
				margin: 0 auto;
				padding: 3em 1.25em 1em;
			}
			.cat-head {
				display: flex;
				align-items: center;
				gap: 0.85em;
				margin-bottom: 1.5em;
			}
			.cat-icon {
				display: grid;
				place-items: center;
				width: 50px;
				height: 50px;
				border-radius: 12px;
				font-size: 1.4em;
				box-shadow: var(--glow-violet);
			}
			.cat-head h2 {
				margin: 0;
				font-size: 1.6em;
			}
			.tool-grid {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
				gap: 1em;
			}
			.tool-card {
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: 14px;
				transition: 0.2s ease;
				overflow: hidden;
				position: relative;
			}
			.tool-card:hover {
				border-color: var(--border-glow);
				transform: translateY(-3px);
				box-shadow: var(--shadow-card-hover);
			}
			.tool-card a,
			.tool-card .static-card {
				display: block;
				padding: 1.25em;
				text-decoration: none;
				color: var(--text);
				height: 100%;
			}
			.row {
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				gap: 0.5em;
				margin-bottom: 0.6em;
				flex-wrap: wrap;
			}
			.row h3 {
				margin: 0;
				font-size: 1.1em;
				font-family: var(--font-display);
			}
			.free-badge {
				font-size: 0.65em;
				font-weight: 700;
				color: white;
				padding: 0.25em 0.6em;
				border-radius: 999px;
				white-space: nowrap;
			}
			.tool-card p {
				margin: 0 0 0.8em 0;
				color: var(--text-muted);
				font-size: 0.9em;
				line-height: 1.5;
			}
			.tool-tag {
				display: inline-block;
				font-size: 0.78em;
				padding: 0.2em 0.6em;
				background: var(--surface-2);
				color: var(--text-muted);
				border-radius: 6px;
				margin-right: 0.5em;
			}
			.read-cta {
				display: inline-block;
				font-size: 0.85em;
				color: #c4b5fd;
				font-weight: 600;
				margin-top: 0.5em;
			}
			.tool-card:hover .read-cta {
				color: #f9a8d4;
			}
		</style>
	</body>
</html>
