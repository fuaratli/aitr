---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_LANG, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pageTitle = `Yazılar — ${SITE_TITLE}`;
const pageDescription =
	'Tüm yapay zeka araçları yazıları: karşılaştırmalar, rehberler, incelemeler.';
---

<!doctype html>
<html lang={SITE_LANG}>
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body>
		<Header />
		<main class="blog-main">
			<header class="blog-hero">
				<div class="mesh-bg" aria-hidden="true"></div>
				<div class="inner">
					<span class="pill pill-glow">Tüm yazılar</span>
					<h1>Yapay Zeka <span class="gradient-text">Kütüphanesi</span></h1>
					<p>{pageDescription}</p>
				</div>
			</header>

			<section class="list-wrap">
				{
					posts.length === 0 ? (
						<div class="empty">Yazılar çok yakında.</div>
					) : (
						<ul class="post-grid">
							{posts.map((post) => (
								<li class="post-card">
									<a href={`/blog/${post.id}/`}>
										{post.data.heroImage && (
											<div class="img-wrap">
												<Image width={720} height={360} src={post.data.heroImage} alt={post.data.title} />
											</div>
										)}
										<div class="body">
											<span class="pill">Yazı</span>
											<h2>{post.data.title}</h2>
											<p class="excerpt">{post.data.description}</p>
											<p class="date">
												<FormattedDate date={post.data.pubDate} />
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
					)
				}
			</section>
		</main>
		<Footer />

		<style>
			.blog-main {
				max-width: 100%;
				padding: 0;
			}
			.blog-hero {
				position: relative;
				overflow: hidden;
				padding: 5em 1.25em 3em;
				text-align: center;
				border-bottom: 1px solid var(--border);
			}
			.blog-hero .inner {
				position: relative;
				z-index: 2;
				max-width: 760px;
				margin: 0 auto;
				animation: fade-up 0.5s ease both;
			}
			.blog-hero .pill {
				margin-bottom: 1em;
			}
			.blog-hero h1 {
				font-size: clamp(2em, 5vw, 3.4em);
				margin: 0 0 0.4em 0;
				letter-spacing: -0.03em;
			}
			.blog-hero p {
				color: var(--text-muted);
				max-width: 560px;
				margin: 0 auto;
				font-size: 1.05em;
			}
			.list-wrap {
				max-width: 1200px;
				margin: 0 auto;
				padding: 4em 1.25em;
			}
			.post-grid {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				gap: 1.5em;
			}
			.post-card {
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: 16px;
				overflow: hidden;
				transition: 0.25s ease;
				backdrop-filter: blur(12px);
			}
			.post-card:hover {
				border-color: var(--border-glow);
				transform: translateY(-3px);
				box-shadow: var(--shadow-card-hover);
			}
			.post-card a {
				text-decoration: none;
				color: var(--text);
				display: block;
				height: 100%;
			}
			.img-wrap {
				overflow: hidden;
				background: var(--bg-2);
			}
			.img-wrap img {
				display: block;
				width: 100%;
				height: 200px;
				object-fit: cover;
				transition: transform 0.4s ease;
				border-radius: 0;
			}
			.post-card:hover .img-wrap img {
				transform: scale(1.04);
			}
			.body {
				padding: 1.5em;
			}
			.body .pill {
				margin-bottom: 0.85em;
			}
			.body h2 {
				margin: 0 0 0.5em 0;
				font-size: 1.25em;
				line-height: 1.3;
				color: var(--text);
			}
			.excerpt {
				color: var(--text-muted);
				font-size: 0.95em;
				margin: 0 0 1em 0;
				line-height: 1.55;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.date {
				font-size: 0.82em;
				color: var(--text-dim);
				margin: 0;
			}
			.empty {
				text-align: center;
				padding: 3em 1em;
				color: var(--text-muted);
				border: 1px dashed var(--border);
				border-radius: 12px;
			}
			@media (max-width: 720px) {
				.blog-hero {
					padding: 3em 1em 2em;
				}
				.list-wrap {
					padding: 2.5em 1em;
				}
			}
		</style>
	</body>
</html>
