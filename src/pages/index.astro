---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_LANG, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 8);
---

<!doctype html>
<html lang={SITE_LANG}>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding: 3em 1em 2em 1em;
				text-align: center;
			}
			.hero h1 {
				font-size: 2.5em;
				line-height: 1.15;
				margin-bottom: 0.5em;
			}
			.hero p.lead {
				font-size: 1.15em;
				color: rgb(var(--gray-dark));
				max-width: 720px;
				margin: 0 auto 1.5em auto;
			}
			.cta-row {
				display: flex;
				gap: 0.75em;
				justify-content: center;
				flex-wrap: wrap;
			}
			.btn {
				display: inline-block;
				padding: 0.7em 1.4em;
				border-radius: 8px;
				text-decoration: none;
				font-weight: 700;
				transition: 0.15s ease;
			}
			.btn-primary {
				background: var(--accent);
				color: white;
			}
			.btn-primary:hover {
				background: var(--accent-dark);
				color: white;
			}
			.btn-ghost {
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
			}
			.btn-ghost:hover {
				background: rgb(var(--gray));
				color: white;
			}
			section.categories {
				padding: 2em 1em;
			}
			.categories h2 {
				text-align: center;
				margin-bottom: 1em;
			}
			.cat-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
				gap: 1em;
				max-width: 960px;
				margin: 0 auto;
			}
			.cat-card {
				display: block;
				padding: 1.5em;
				background: white;
				border-radius: 12px;
				box-shadow: 0 2px 8px rgba(var(--black), 4%);
				text-decoration: none;
				color: rgb(var(--gray-dark));
				transition: 0.15s ease;
			}
			.cat-card:hover {
				transform: translateY(-2px);
				box-shadow: var(--box-shadow);
				color: rgb(var(--gray-dark));
			}
			.cat-card h3 {
				margin-top: 0;
				font-size: 1.25em;
			}
			.cat-card p {
				margin: 0;
				font-size: 0.95em;
				color: rgb(var(--gray));
			}
			.cat-emoji {
				font-size: 2em;
				display: block;
				margin-bottom: 0.5em;
			}
			section.latest {
				padding: 2em 1em 4em 1em;
				max-width: 960px;
				margin: 0 auto;
			}
			.latest h2 {
				margin-bottom: 1em;
			}
			.post-list {
				list-style: none;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1.25em;
			}
			.post-card {
				background: white;
				border-radius: 12px;
				overflow: hidden;
				box-shadow: 0 2px 8px rgba(var(--black), 4%);
				transition: 0.15s ease;
			}
			.post-card:hover {
				transform: translateY(-2px);
				box-shadow: var(--box-shadow);
			}
			.post-card a {
				text-decoration: none;
				color: rgb(var(--gray-dark));
				display: block;
			}
			.post-card img {
				width: 100%;
				height: 180px;
				object-fit: cover;
				display: block;
				border-radius: 0;
			}
			.post-card .body {
				padding: 1em;
			}
			.post-card h4 {
				margin: 0 0 0.5em 0;
				font-size: 1.1em;
				line-height: 1.3;
			}
			.post-card .date {
				font-size: 0.85em;
				color: rgb(var(--gray));
			}
			.empty {
				text-align: center;
				padding: 2em;
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				.hero h1 {
					font-size: 1.85em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main style="width: 100%; max-width: 100%; padding: 0;">
			<section class="hero">
				<h1>Yapay Zeka Araçlarını Türkçe Keşfet</h1>
				<p class="lead">
					ChatGPT, Claude, Gemini, Midjourney ve onlarca AI aracı için karşılaştırmalar,
					Türkçe kullanım rehberleri ve dürüst incelemeler. Hangi araç senin için doğru,
					burada öğren.
				</p>
				<div class="cta-row">
					<a class="btn btn-primary" href="/blog">Tüm Yazılar</a>
					<a class="btn btn-ghost" href="/about">Bu Site Nedir?</a>
				</div>
			</section>

			<section class="categories">
				<h2>Kategoriler</h2>
				<div class="cat-grid">
					<a class="cat-card" href="/blog">
						<span class="cat-emoji">⚖️</span>
						<h3>Karşılaştırmalar</h3>
						<p>ChatGPT vs Claude, Midjourney vs DALL-E ve daha fazlası.</p>
					</a>
					<a class="cat-card" href="/blog">
						<span class="cat-emoji">📘</span>
						<h3>Kullanım Rehberleri</h3>
						<p>Adım adım Türkçe AI aracı kullanım rehberleri.</p>
					</a>
					<a class="cat-card" href="/blog">
						<span class="cat-emoji">🔍</span>
						<h3>İncelemeler</h3>
						<p>Detaylı, deneyimsel araç incelemeleri ve testler.</p>
					</a>
					<a class="cat-card" href="/blog">
						<span class="cat-emoji">💼</span>
						<h3>Para Kazanma</h3>
						<p>Yapay zeka ile gerçek gelir yaratmanın yolları.</p>
					</a>
				</div>
			</section>

			<section class="latest">
				<h2>Son Yazılar</h2>
				{
					posts.length === 0 ? (
						<p class="empty">Yazılar yakında burada olacak.</p>
					) : (
						<ul class="post-list">
							{posts.map((post) => (
								<li class="post-card">
									<a href={`/blog/${post.id}/`}>
										{post.data.heroImage && (
											<Image
												width={560}
												height={280}
												src={post.data.heroImage}
												alt={post.data.title}
											/>
										)}
										<div class="body">
											<h4>{post.data.title}</h4>
											<p class="date">
												<FormattedDate date={post.data.pubDate} />
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
