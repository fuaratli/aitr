---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE_DESCRIPTION, SITE_LANG, SITE_TITLE } from '../consts';
import { CATEGORY_META } from '../content.config';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const posts = allPosts.slice(0, 6);
const featured = posts[0];
---

<!doctype html>
<html lang={SITE_LANG}>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-main">
			<!-- HERO -->
			<section class="hero">
				<div class="mesh-bg" aria-hidden="true"></div>
				<div class="hero-inner">
					<a href="/blog/chatgpt-claude-gemini-karsilastirma-2026/" class="pill pill-glow announce">
						<span class="dot"></span>
						Yeni: ChatGPT vs Claude vs Gemini 2026 karşılaştırması
						<span class="arrow">→</span>
					</a>
					<h1 class="hero-title">
						Yapay zekayı <span class="gradient-text">Türkçe</span><br />
						keşfet, kullan, ileri taşı.
					</h1>
					<p class="hero-sub">
						ChatGPT, Claude, Gemini, Midjourney ve onlarca AI aracı için derinlikli
						karşılaştırmalar, dürüst incelemeler ve adım adım Türkçe rehberler.
					</p>
					<div class="cta-row">
						<a class="btn btn-primary" href="/blog">
							Yazıları Keşfet
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
						</a>
						<a class="btn btn-ghost" href="/about">AITR Nedir?</a>
					</div>
					<div class="brand-row" aria-label="Bu sitede ele aldığımız markalar">
						<a class="brand-chip" href="/blog/kategori/karsilastirmalar">ChatGPT</a>
						<a class="brand-chip" href="/blog/kategori/karsilastirmalar">Claude</a>
						<a class="brand-chip" href="/blog/kategori/karsilastirmalar">Gemini</a>
						<a class="brand-chip" href="/blog/kategori/rehberler">Midjourney</a>
						<a class="brand-chip" href="/blog/kategori/incelemeler">Cursor</a>
						<a class="brand-chip" href="/blog/kategori/incelemeler">Perplexity</a>
						<a class="brand-chip" href="/blog/kategori/rehberler">Notion AI</a>
					</div>
				</div>
			</section>

			<!-- ÜST REKLAM -->
			<div class="ad-wrap">
				<AdSlot size="leaderboard" label="Reklam" slot="home-top" />
			</div>

			<!-- KATEGORİLER -->
			<section class="section reveal">
				<header class="section-head">
					<h2>Ne ararsan burada</h2>
					<p>Dört ana kategoride üretiyoruz, hepsi Türkçe ve uygulamaya dönük.</p>
				</header>
				<div class="cat-grid">
					{
						(Object.entries(CATEGORY_META) as [keyof typeof CATEGORY_META, (typeof CATEGORY_META)[keyof typeof CATEGORY_META]][]).map(
							([key, meta]) => (
								<a class="cat-card" href={`/blog/kategori/${meta.slug}/`}>
									<div class="cat-emoji" style={`--g: ${meta.gradient}`}>{meta.emoji}</div>
									<h3>{meta.label}</h3>
									<p>{meta.description}</p>
								</a>
							)
						)
					}
				</div>
			</section>

			<!-- ÖNE ÇIKAN İSTATİSTİKLER (alanı dolu gösteriyor + güven) -->
			<section class="stats reveal">
				<div class="stat">
					<div class="stat-num gradient-text">30+</div>
					<div class="stat-label">İncelenen AI aracı</div>
				</div>
				<div class="stat">
					<div class="stat-num gradient-text">100%</div>
					<div class="stat-label">Türkçe içerik</div>
				</div>
				<div class="stat">
					<div class="stat-num gradient-text">0₺</div>
					<div class="stat-label">Reklamsız okuma</div>
				</div>
				<div class="stat">
					<div class="stat-num gradient-text">2026</div>
					<div class="stat-label">Güncel veri</div>
				</div>
			</section>

			<!-- ORTA REKLAM -->
			<div class="ad-wrap">
				<AdSlot size="responsive" label="Reklam" slot="home-mid" />
			</div>

			<!-- SON YAZILAR -->
			<section class="section reveal">
				<header class="section-head">
					<h2>Son Yazılar</h2>
					<p>En yeni karşılaştırmalar, rehberler ve incelemeler.</p>
				</header>
				{
					posts.length === 0 ? (
						<div class="empty">Yazılar yakında burada olacak.</div>
					) : (
						<ul class="post-grid">
							{posts.map((post, i) => (
								<li class={`post-card ${i === 0 ? 'post-card-feature' : ''}`}>
									<a href={`/blog/${post.id}/`}>
										{i === 0 && <span class="badge-new badge-new-corner">YENİ</span>}
										{post.data.heroImage && (
											<div class="img-wrap">
												<Image
													width={i === 0 ? 1100 : 560}
													height={i === 0 ? 460 : 280}
													src={post.data.heroImage}
													alt={post.data.title}
												/>
											</div>
										)}
										<div class="body">
											<span class="pill">Karşılaştırma</span>
											<h4>{post.data.title}</h4>
											<p class="excerpt">{post.data.description}</p>
											<p class="date">
												<FormattedDate date={post.data.pubDate} />
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
					)
				}
				<div class="see-all">
					<a class="btn btn-ghost" href="/blog">Tüm yazılar →</a>
				</div>
			</section>

			<!-- ALT REKLAM -->
			<div class="ad-wrap">
				<AdSlot size="banner" label="Reklam" slot="home-bottom" />
			</div>
		</main>
		<Footer />

		<style>
			.home-main {
				max-width: 100%;
				padding: 0;
			}

			/* HERO */
			.hero {
				position: relative;
				overflow: hidden;
				padding: 6em 1.25em 5em;
				text-align: center;
				border-bottom: 1px solid var(--border);
			}
			.hero-inner {
				position: relative;
				z-index: 2;
				max-width: 880px;
				margin: 0 auto;
				animation: fade-up 0.6s ease both;
			}
			.announce {
				margin-bottom: 1.5em;
				font-weight: 500;
				text-decoration: none;
				cursor: pointer;
				transition: 0.2s ease;
			}
			.announce:hover {
				transform: translateY(-1px);
				box-shadow: var(--glow-violet);
				color: white;
			}
			.announce .dot {
				width: 8px;
				height: 8px;
				background: var(--accent-2);
				border-radius: 50%;
				animation: pulse-dot 1.6s ease-in-out infinite;
			}
			.announce .arrow {
				color: var(--text-muted);
				transition: 0.2s ease;
			}
			.announce:hover .arrow {
				transform: translateX(3px);
				color: white;
			}
			.hero-title {
				font-size: clamp(2.4em, 6vw, 4.2em);
				line-height: 1.05;
				margin: 0 0 0.5em 0;
				letter-spacing: -0.035em;
				font-weight: 700;
			}
			.hero-sub {
				font-size: 1.2em;
				color: var(--text-muted);
				max-width: 680px;
				margin: 0 auto 2em auto;
				line-height: 1.6;
			}
			.cta-row {
				display: flex;
				gap: 0.75em;
				justify-content: center;
				flex-wrap: wrap;
				margin-bottom: 3em;
			}
			.brand-row {
				display: flex;
				justify-content: center;
				flex-wrap: wrap;
				gap: 0.5em;
				opacity: 0.85;
			}
			.brand-chip {
				font-size: 0.82em;
				color: var(--text-muted);
				padding: 0.35em 0.85em;
				border: 1px solid var(--border);
				border-radius: 999px;
				background: var(--surface);
				font-weight: 500;
				font-family: var(--font-display);
				animation: float-tiny 4.5s ease-in-out infinite;
				transition: 0.2s ease;
			}
			.brand-chip:hover {
				color: var(--text);
				border-color: var(--border-glow);
				background: var(--surface-2);
			}
			.brand-chip:nth-child(1) { animation-delay: 0s; }
			.brand-chip:nth-child(2) { animation-delay: -0.6s; }
			.brand-chip:nth-child(3) { animation-delay: -1.2s; }
			.brand-chip:nth-child(4) { animation-delay: -1.8s; }
			.brand-chip:nth-child(5) { animation-delay: -2.4s; }
			.brand-chip:nth-child(6) { animation-delay: -3s; }
			.brand-chip:nth-child(7) { animation-delay: -3.6s; }

			/* SECTIONS */
			.section {
				max-width: 1200px;
				margin: 0 auto;
				padding: 5em 1.25em;
			}
			.section-head {
				text-align: center;
				margin-bottom: 2.5em;
			}
			.section-head h2 {
				font-size: clamp(1.8em, 4vw, 2.5em);
				margin-bottom: 0.4em;
			}
			.section-head p {
				color: var(--text-muted);
				max-width: 580px;
				margin: 0 auto;
				font-size: 1.05em;
			}

			/* CATEGORY GRID */
			.cat-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
				gap: 1.25em;
			}
			.cat-card {
				display: block;
				padding: 1.75em;
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: 16px;
				text-decoration: none;
				color: var(--text);
				transition: 0.25s ease;
				backdrop-filter: blur(12px);
				position: relative;
				overflow: hidden;
			}
			.cat-card::before {
				content: '';
				position: absolute;
				inset: 0;
				background: var(--g, var(--gradient-1));
				opacity: 0;
				transition: 0.25s ease;
				border-radius: inherit;
				z-index: 0;
				filter: blur(40px);
			}
			.cat-card:hover {
				border-color: var(--border-glow);
				transform: translateY(-4px);
				box-shadow: var(--shadow-card-hover);
				color: var(--text);
			}
			.cat-card:hover::before {
				opacity: 0.08;
			}
			.cat-card > * {
				position: relative;
				z-index: 1;
			}
			.cat-emoji {
				display: inline-grid;
				place-items: center;
				width: 50px;
				height: 50px;
				background: var(--g, var(--gradient-1));
				border-radius: 12px;
				font-size: 1.4em;
				margin-bottom: 1em;
				box-shadow: var(--glow-violet);
			}
			.cat-card h3 {
				margin: 0 0 0.4em 0;
				font-size: 1.15em;
			}
			.cat-card p {
				margin: 0;
				font-size: 0.95em;
				color: var(--text-muted);
				line-height: 1.6;
			}

			/* STATS */
			.stats {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
				gap: 1em;
				max-width: 1100px;
				margin: 0 auto;
				padding: 2em 1.25em;
				border-top: 1px solid var(--border);
				border-bottom: 1px solid var(--border);
				background: linear-gradient(180deg, transparent, rgba(139, 92, 246, 0.03));
			}
			.stat {
				text-align: center;
				padding: 1em;
			}
			.stat-num {
				font-family: var(--font-display);
				font-size: 2.4em;
				font-weight: 700;
				letter-spacing: -0.04em;
				line-height: 1;
				margin-bottom: 0.3em;
			}
			.stat-label {
				color: var(--text-muted);
				font-size: 0.9em;
			}

			/* POST GRID */
			.post-grid {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1.5em;
			}
			.post-card {
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: 16px;
				overflow: hidden;
				transition: 0.25s ease;
				backdrop-filter: blur(12px);
			}
			.post-card:hover {
				border-color: var(--border-glow);
				transform: translateY(-3px);
				box-shadow: var(--shadow-card-hover);
			}
			.post-card a {
				text-decoration: none;
				color: var(--text);
				display: block;
				height: 100%;
				position: relative;
			}
			.badge-new-corner {
				position: absolute;
				top: 1em;
				right: 1em;
				z-index: 4;
			}
			.post-card-feature {
				grid-column: 1 / -1;
				display: grid;
				grid-template-columns: 1.3fr 1fr;
			}
			.post-card-feature a {
				display: contents;
			}
			.post-card-feature .img-wrap img {
				height: 100%;
				min-height: 320px;
			}
			.post-card-feature .body {
				padding: 2em;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}
			.post-card-feature h4 {
				font-size: 1.7em;
				margin-bottom: 0.5em;
			}
			.img-wrap {
				overflow: hidden;
				background: var(--bg-2);
			}
			.img-wrap img {
				display: block;
				width: 100%;
				height: 200px;
				object-fit: cover;
				transition: transform 0.4s ease;
				border-radius: 0;
			}
			.post-card:hover .img-wrap img {
				transform: scale(1.04);
			}
			.body {
				padding: 1.25em;
			}
			.body .pill {
				margin-bottom: 0.85em;
			}
			.body h4 {
				margin: 0 0 0.5em 0;
				font-size: 1.15em;
				line-height: 1.3;
				color: var(--text);
			}
			.excerpt {
				color: var(--text-muted);
				font-size: 0.95em;
				margin: 0 0 1em 0;
				line-height: 1.55;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.date {
				font-size: 0.82em;
				color: var(--text-dim);
				margin: 0;
			}
			.empty {
				text-align: center;
				padding: 3em 1em;
				color: var(--text-muted);
				border: 1px dashed var(--border);
				border-radius: 12px;
			}
			.see-all {
				text-align: center;
				margin-top: 2.5em;
			}
			.ad-wrap {
				display: flex;
				justify-content: center;
				padding: 0 1.25em;
				max-width: 1200px;
				margin: 0 auto;
			}

			@media (max-width: 760px) {
				.hero {
					padding: 3.5em 1em 3em;
				}
				.hero-sub {
					font-size: 1.05em;
				}
				.section {
					padding: 3em 1em;
				}
				.post-card-feature {
					grid-template-columns: 1fr;
				}
				.post-card-feature .img-wrap img {
					min-height: auto;
					height: 220px;
				}
				.post-card-feature .body {
					padding: 1.25em;
				}
				.post-card-feature h4 {
					font-size: 1.25em;
				}
			}
		</style>
	</body>
</html>
