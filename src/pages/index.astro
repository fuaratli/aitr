---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import AdSlot from '../components/AdSlot.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import HeroCover from '../components/HeroCover.astro';
import { SITE_DESCRIPTION, SITE_LANG, SITE_TITLE } from '../consts';
import { CATEGORY_META } from '../lib/categories';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const posts = allPosts.slice(0, 6);
const featured = posts[0];
---

<!doctype html>
<html lang={SITE_LANG}>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-main">
			<!-- HERO -->
			<section class="hero">
				<div class="hero-inner">
					<a href="/blog/chatgpt-claude-gemini-karsilastirma-2026/" class="pill announce">
						<span class="dot"></span>
						Yeni: ChatGPT vs Claude vs Gemini 2026 karşılaştırması
						<span class="arrow">→</span>
					</a>
					<h1 class="display-xl hero-title">
						Yapay zekayı<br />
						<span class="accent-word">Türkçe</span> keşfet
					</h1>
					<p class="hero-sub">
						ChatGPT, Claude, Gemini, Midjourney ve onlarca AI aracı için derinlikli
						karşılaştırmalar, dürüst incelemeler ve adım adım Türkçe rehberler.
					</p>
					<div class="cta-row">
						<a class="btn btn-primary" href="/blog">
							Yazıları Keşfet
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
						</a>
						<a class="btn btn-ghost" href="/about">AITR Nedir?</a>
					</div>
				</div>
				<div class="marquee hero-marquee" aria-label="Ele aldığımız AI araçları">
					<div class="marquee-track">
						<a class="marquee-item" href="/blog/kategori/karsilastirmalar">ChatGPT<span class="sep">·</span></a>
						<a class="marquee-item" href="/blog/kategori/karsilastirmalar">Claude<span class="sep">·</span></a>
						<a class="marquee-item" href="/blog/kategori/karsilastirmalar">Gemini<span class="sep">·</span></a>
						<a class="marquee-item" href="/blog/kategori/rehberler">Midjourney<span class="sep">·</span></a>
						<a class="marquee-item" href="/blog/kategori/incelemeler">Cursor<span class="sep">·</span></a>
						<a class="marquee-item" href="/blog/kategori/incelemeler">Perplexity<span class="sep">·</span></a>
						<a class="marquee-item" href="/blog/kategori/rehberler">Notion AI<span class="sep">·</span></a>
						<a class="marquee-item" href="/blog/kategori/rehberler">Suno<span class="sep">·</span></a>
						<a class="marquee-item" href="/blog/kategori/karsilastirmalar">ChatGPT<span class="sep">·</span></a>
						<a class="marquee-item" href="/blog/kategori/karsilastirmalar">Claude<span class="sep">·</span></a>
						<a class="marquee-item" href="/blog/kategori/karsilastirmalar">Gemini<span class="sep">·</span></a>
						<a class="marquee-item" href="/blog/kategori/rehberler">Midjourney<span class="sep">·</span></a>
						<a class="marquee-item" href="/blog/kategori/incelemeler">Cursor<span class="sep">·</span></a>
						<a class="marquee-item" href="/blog/kategori/incelemeler">Perplexity<span class="sep">·</span></a>
						<a class="marquee-item" href="/blog/kategori/rehberler">Notion AI<span class="sep">·</span></a>
						<a class="marquee-item" href="/blog/kategori/rehberler">Suno<span class="sep">·</span></a>
					</div>
				</div>
			</section>

			<!-- ÜST REKLAM -->
			<div class="ad-wrap">
				<AdSlot size="leaderboard" label="Reklam" slot="home-top" />
			</div>

			<!-- KATEGORİLER -->
			<section class="section reveal">
				<header class="section-head">
					<h2>Ne ararsan burada</h2>
					<p>Dört ana kategoride üretiyoruz, hepsi Türkçe ve uygulamaya dönük.</p>
				</header>
				<div class="cat-grid">
					{
						(Object.entries(CATEGORY_META) as [keyof typeof CATEGORY_META, (typeof CATEGORY_META)[keyof typeof CATEGORY_META]][]).map(
							([key, meta]) => (
								<a class="cat-card" href={`/blog/kategori/${meta.slug}/`}>
									<div class="cat-emoji" style={`--g: ${meta.gradient}`}>{meta.emoji}</div>
									<h3>{meta.label}</h3>
									<p>{meta.description}</p>
								</a>
							)
						)
					}
				</div>
			</section>

			<!-- ÖNE ÇIKAN İSTATİSTİKLER (alanı dolu gösteriyor + güven) -->
			<section class="stats reveal">
				<div class="stat">
					<div class="stat-num gradient-text" data-count="30" data-suffix="+">0+</div>
					<div class="stat-label">İncelenen AI aracı</div>
				</div>
				<div class="stat">
					<div class="stat-num gradient-text" data-count="100" data-suffix="%">0%</div>
					<div class="stat-label">Türkçe içerik</div>
				</div>
				<div class="stat">
					<div class="stat-num gradient-text">0₺</div>
					<div class="stat-label">Reklamsız okuma</div>
				</div>
				<div class="stat">
					<div class="stat-num gradient-text">2026</div>
					<div class="stat-label">Güncel veri</div>
				</div>
			</section>

			<!-- ORTA REKLAM -->
			<div class="ad-wrap">
				<AdSlot size="responsive" label="Reklam" slot="home-mid" />
			</div>

			<!-- SON YAZILAR -->
			<section class="section reveal">
				<header class="section-head">
					<h2>Son Yazılar</h2>
					<p>En yeni karşılaştırmalar, rehberler ve incelemeler.</p>
				</header>
				{
					posts.length === 0 ? (
						<div class="empty">Yazılar yakında burada olacak.</div>
					) : (
						<ul class="post-grid">
							{posts.map((post, i) => (
								<li class={`post-card ${i === 0 ? 'post-card-feature' : ''}`}>
									<a href={`/blog/${post.id}/`}>
										{i === 0 && <span class="badge-new badge-new-corner">YENİ</span>}
										<div class="img-wrap">
											{post.data.heroImage ? (
												<Image
													width={i === 0 ? 1100 : 560}
													height={i === 0 ? 460 : 280}
													src={post.data.heroImage}
													alt={post.data.title}
												/>
											) : (
												<HeroCover title={post.data.title} category={post.data.category} size={i === 0 ? 'large' : 'medium'} />
											)}
										</div>
										<div class="body">
											<span class="pill">{CATEGORY_META[post.data.category]?.label ?? 'Yazı'}</span>
											<h4>{post.data.title}</h4>
											<p class="excerpt">{post.data.description}</p>
											<p class="date">
												<FormattedDate date={post.data.pubDate} />
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
					)
				}
				<div class="see-all">
					<a class="btn btn-ghost" href="/blog">Tüm yazılar →</a>
				</div>
			</section>

			<!-- BÜLTEN -->
			<div class="reveal">
				<NewsletterSignup variant="section" />
			</div>

			<!-- ALT REKLAM -->
			<div class="ad-wrap">
				<AdSlot size="banner" label="Reklam" slot="home-bottom" />
			</div>
		</main>
		<Footer />

		<style>
			.home-main {
				max-width: 100%;
				padding: 0;
			}

			/* HERO */
			.hero {
				position: relative;
				overflow: hidden;
				padding: 7em 1.25em 3.5em;
				text-align: left;
				border-bottom: 1px solid var(--border);
			}
			.hero-inner {
				position: relative;
				z-index: 2;
				max-width: 1200px;
				margin: 0 auto;
				animation: fade-up 0.6s ease both;
			}
			.announce { margin-bottom: 2em; font-weight: 500; text-decoration: none; cursor: pointer; transition: 0.2s ease; }
			.announce:hover { transform: translateY(-1px); border-color: var(--border-glow); color: var(--text); }
			.announce .dot { width: 8px; height: 8px; background: var(--accent); border-radius: 50%; }
			.announce .arrow { color: var(--text-muted); transition: 0.2s ease; }
			.announce:hover .arrow { transform: translateX(3px); color: var(--text); }
			.hero-title { margin: 0 0 0.4em 0; }
			.accent-word { color: var(--accent); }
			.hero-sub {
				font-size: 1.2em;
				color: var(--text-muted);
				max-width: 560px;
				margin: 0 0 2em 0;
				line-height: 1.6;
			}
			.cta-row {
				display: flex;
				gap: 0.75em;
				justify-content: flex-start;
				flex-wrap: wrap;
			}
			.hero-marquee {
				margin-top: 2.5em;
				padding-top: 2.5em;
				border-top: 1px solid var(--border);
			}

			/* SECTIONS */
			.section {
				max-width: 1200px;
				margin: 0 auto;
				padding: 5em 1.25em;
			}
			.section-head {
				text-align: center;
				margin-bottom: 2.5em;
			}
			.section-head h2 {
				font-size: clamp(1.8em, 4vw, 2.5em);
				margin-bottom: 0.4em;
			}
			.section-head p {
				color: var(--text-muted);
				max-width: 580px;
				margin: 0 auto;
				font-size: 1.05em;
			}

			/* CATEGORY GRID */
			.cat-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
				gap: 1.25em;
			}
			.cat-card {
				display: block;
				padding: 1.75em;
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: 16px;
				text-decoration: none;
				color: var(--text);
				transition: 0.25s ease;
				backdrop-filter: blur(12px);
				position: relative;
				overflow: hidden;
			}
			.cat-card::before {
				content: '';
				position: absolute;
				inset: 0;
				background: var(--g, var(--surface-2));
				opacity: 0;
				transition: 0.25s ease;
				border-radius: inherit;
				z-index: 0;
				filter: blur(40px);
			}
			.cat-card:hover {
				border-color: var(--border-glow);
				transform: translateY(-4px);
				box-shadow: var(--shadow-card-hover);
				color: var(--text);
			}
			.cat-card:hover::before {
				opacity: 0.08;
			}
			.cat-card > * {
				position: relative;
				z-index: 1;
			}
			.cat-emoji {
				display: inline-grid;
				place-items: center;
				width: 50px;
				height: 50px;
				background: var(--g, var(--surface-2));
				border-radius: 12px;
				font-size: 1.4em;
				margin-bottom: 1em;
			}
			.cat-card h3 {
				margin: 0 0 0.4em 0;
				font-size: 1.15em;
			}
			.cat-card p {
				margin: 0;
				font-size: 0.95em;
				color: var(--text-muted);
				line-height: 1.6;
			}

			/* STATS */
			.stats {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
				gap: 1em;
				max-width: 1100px;
				margin: 0 auto;
				padding: 2em 1.25em;
				border-top: 1px solid var(--border);
				border-bottom: 1px solid var(--border);
				background: transparent;
			}
			.stat {
				text-align: center;
				padding: 1em;
			}
			.stat-num {
				font-family: var(--font-display);
				font-size: 2.4em;
				font-weight: 700;
				letter-spacing: -0.04em;
				line-height: 1;
				margin-bottom: 0.3em;
			}
			.stat-label {
				color: var(--text-muted);
				font-size: 0.9em;
			}

			/* POST GRID */
			.post-grid {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1.5em;
			}
			.post-card {
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: 16px;
				overflow: hidden;
				transition: 0.25s ease;
				backdrop-filter: blur(12px);
			}
			.post-card:hover {
				border-color: var(--border-glow);
				transform: translateY(-3px);
				box-shadow: var(--shadow-card-hover);
			}
			.post-card a {
				text-decoration: none;
				color: var(--text);
				display: block;
				height: 100%;
				position: relative;
			}
			.badge-new-corner {
				position: absolute;
				top: 1em;
				right: 1em;
				z-index: 4;
			}
			.post-card-feature {
				grid-column: 1 / -1;
				display: grid;
				grid-template-columns: 1.3fr 1fr;
			}
			.post-card-feature a {
				display: contents;
			}
			.post-card-feature .img-wrap {
				aspect-ratio: auto;
				height: 100%;
			}
			.post-card-feature .img-wrap img,
			.post-card-feature .img-wrap :global(.hcover) {
				height: 100%;
				min-height: 320px;
			}
			.post-card-feature .body {
				padding: 2em;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}
			.post-card-feature h4 {
				font-size: 1.7em;
				margin-bottom: 0.5em;
			}
			.img-wrap {
				overflow: hidden;
				background: var(--bg-2);
				aspect-ratio: 16 / 9;
			}
			.img-wrap img,
			.img-wrap :global(.hcover) {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.4s ease;
				border-radius: 0;
			}
			.post-card:hover .img-wrap img,
			.post-card:hover .img-wrap :global(.hcover) {
				transform: scale(1.04);
			}
			.body {
				padding: 1.25em;
			}
			.body .pill {
				margin-bottom: 0.85em;
			}
			.body h4 {
				margin: 0 0 0.5em 0;
				font-size: 1.15em;
				line-height: 1.3;
				color: var(--text);
			}
			.excerpt {
				color: var(--text-muted);
				font-size: 0.95em;
				margin: 0 0 1em 0;
				line-height: 1.55;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.date {
				font-size: 0.82em;
				color: var(--text-dim);
				margin: 0;
			}
			.empty {
				text-align: center;
				padding: 3em 1em;
				color: var(--text-muted);
				border: 1px dashed var(--border);
				border-radius: 12px;
			}
			.see-all {
				text-align: center;
				margin-top: 2.5em;
			}
			.ad-wrap {
				display: flex;
				justify-content: center;
				padding: 0 1.25em;
				max-width: 1200px;
				margin: 0 auto;
			}

			@media (max-width: 760px) {
				.hero {
					padding: 3.5em 1em 3em;
				}
				.hero-sub {
					font-size: 1.05em;
				}
				.section {
					padding: 3em 1em;
				}
				.post-card-feature {
					grid-template-columns: 1fr;
				}
				.post-card-feature .img-wrap img {
					min-height: auto;
					height: 220px;
				}
				.post-card-feature .body {
					padding: 1.25em;
				}
				.post-card-feature h4 {
					font-size: 1.25em;
				}
			}
		</style>
	</body>
</html>
