---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_LANG, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang={SITE_LANG}>
	<head>
		<BaseHead title={`Sayfa Bulunamadı — ${SITE_TITLE}`} description="Aradığın sayfa bulunamadı." />
	</head>
	<body>
		<Header />
		<main class="nf-main">
			<div class="mesh-bg" aria-hidden="true"></div>
			<div class="inner">
				<div class="code gradient-text">404</div>
				<h1>Bu sayfa kayıp gitmiş.</h1>
				<p>Aradığın yazı taşınmış, silinmiş ya da hiç var olmamış olabilir.</p>
				<div class="actions">
					<a class="btn btn-primary" href="/">Anasayfaya dön</a>
					<a class="btn btn-ghost" href="/blog">Yazılara göz at</a>
				</div>
				<div class="suggestions">
					<p class="hint">Belki şunlar ilgini çeker:</p>
					<ul>
						<li><a href="/blog/chatgpt-claude-gemini-karsilastirma-2026/">ChatGPT vs Claude vs Gemini 2026</a></li>
						<li><a href="/blog/ai-ile-para-kazanma-2026/">AI ile Para Kazanmanın 12 Yolu</a></li>
						<li><a href="/blog/ucretsiz-yapay-zeka-araclari-2026/">Ücretsiz AI Araçları 2026</a></li>
					</ul>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.nf-main {
		position: relative;
		min-height: 70vh;
		display: grid;
		place-items: center;
		padding: 4em 1.25em;
		overflow: hidden;
		max-width: 100%;
	}
	.inner {
		position: relative;
		z-index: 2;
		text-align: center;
		max-width: 600px;
	}
	.code {
		font-family: var(--font-display);
		font-size: clamp(5em, 18vw, 9em);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.05em;
		margin-bottom: 0.1em;
	}
	.nf-main h1 {
		font-size: clamp(1.6em, 4vw, 2.2em);
		margin-bottom: 0.5em;
	}
	.nf-main p {
		color: var(--text-muted);
		margin-bottom: 1.5em;
	}
	.actions {
		display: flex;
		gap: 0.75em;
		justify-content: center;
		flex-wrap: wrap;
		margin-bottom: 2.5em;
	}
	.suggestions {
		padding-top: 1.5em;
		border-top: 1px solid var(--border);
	}
	.hint {
		color: var(--text-dim);
		font-size: 0.9em;
		margin-bottom: 0.5em;
	}
	.suggestions ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.suggestions li {
		margin: 0.4em 0;
	}
	.suggestions a {
		color: #c4b5fd;
		text-decoration: none;
		border-bottom: 1px solid rgba(196, 181, 253, 0.3);
		transition: 0.15s ease;
	}
	.suggestions a:hover {
		color: #f9a8d4;
		border-bottom-color: rgba(249, 168, 212, 0.6);
	}
</style>
