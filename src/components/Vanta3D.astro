---
// 3D Animated Hero Background using Vanta.js (Three.js based)
// LAZY-LOADED + LOW-POWER AWARE: doesn't even load on slow connections / low RAM
---

<div class="vanta-host" id="aitr-vanta" aria-hidden="true"></div>

<style>
	.vanta-host {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.8s ease;
	}
	.vanta-host.ready {
		opacity: 1;
	}
	@media (max-width: 980px), (prefers-reduced-motion: reduce) {
		.vanta-host {
			display: none;
		}
	}
</style>

<script is:inline>
	(function () {
		function isLowPower() {
			try {
				if (navigator.deviceMemory && navigator.deviceMemory < 4) return true;
				var c = navigator.connection;
				if (c && c.saveData) return true;
				if (c && c.effectiveType && ['slow-2g', '2g', '3g'].indexOf(c.effectiveType) !== -1) return true;
			} catch (e) {}
			return false;
		}

		function loadScript(src) {
			return new Promise(function (resolve, reject) {
				var existing = document.querySelector('script[src="' + src + '"]');
				if (existing) {
					if (existing.dataset.loaded) return resolve();
					existing.addEventListener('load', resolve);
					existing.addEventListener('error', reject);
					return;
				}
				var script = document.createElement('script');
				script.src = src;
				script.async = true;
				script.onload = function () {
					script.dataset.loaded = '1';
					resolve();
				};
				script.onerror = reject;
				document.head.appendChild(script);
			});
		}

		function destroyExisting() {
			var host = document.getElementById('aitr-vanta');
			if (host && host.vantaEffect) {
				try { host.vantaEffect.destroy(); } catch (e) {}
				host.vantaEffect = null;
			}
		}

		function setupVanta() {
			var host = document.getElementById('aitr-vanta');
			if (!host || host.dataset.bound) return;
			if (window.innerWidth < 980) return;
			if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			if (isLowPower()) return; // ZAYIF CİHAZ — HİÇ YÜKLEME

			host.dataset.bound = '1';

			// İdle callback ile lazy-load — sayfa açılması bittikten SONRA
			var startLoad = function () {
				loadScript('https://cdn.jsdelivr.net/npm/three@0.134/build/three.min.js')
					.then(function () {
						return loadScript('https://cdn.jsdelivr.net/npm/vanta@0.5.24/dist/vanta.net.min.js');
					})
					.then(function () {
						if (typeof VANTA === 'undefined' || !VANTA.NET) return;
						var isLight = document.documentElement.getAttribute('data-theme') === 'light';
						host.vantaEffect = VANTA.NET({
							el: host,
							mouseControls: true,
							touchControls: false,
							gyroControls: false,
							minHeight: 200,
							minWidth: 200,
							scale: 1.0,
							scaleMobile: 1.0,
							color: 0x8b5cf6,
							backgroundColor: isLight ? 0xfafafd : 0x07070d,
							points: 10.0, // 12 → 10 (daha az iş)
							maxDistance: 22.0,
							spacing: 20.0, // 18 → 20 (daha az link)
							showDots: false,
						});
						setTimeout(function () { host.classList.add('ready'); }, 50);

						// Tab değişince animasyonu duraklat (GPU tasarrufu)
						document.addEventListener('visibilitychange', function () {
							if (!host.vantaEffect) return;
							if (document.hidden) {
								try { host.vantaEffect.pause && host.vantaEffect.pause(); } catch (e) {}
							} else {
								try { host.vantaEffect.play && host.vantaEffect.play(); } catch (e) {}
							}
						});

						// Tema değişikliğine reaksiyon
						var observer = new MutationObserver(function () {
							if (!host.vantaEffect) return;
							var isLightNow = document.documentElement.getAttribute('data-theme') === 'light';
							host.vantaEffect.setOptions({
								backgroundColor: isLightNow ? 0xfafafd : 0x07070d,
							});
						});
						observer.observe(document.documentElement, {
							attributes: true,
							attributeFilter: ['data-theme'],
						});
					})
					.catch(function (e) {
						console.warn('Vanta yüklenemedi:', e);
					});
			};

			// requestIdleCallback varsa kullan, yoksa 2 saniye bekle
			if ('requestIdleCallback' in window) {
				requestIdleCallback(startLoad, { timeout: 3000 });
			} else {
				setTimeout(startLoad, 2000);
			}
		}

		document.addEventListener('astro:page-load', setupVanta);
		document.addEventListener('astro:before-swap', destroyExisting);
	})();
</script>
