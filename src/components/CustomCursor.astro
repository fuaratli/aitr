<div class="cursor-dot" id="aitr-cursor-dot" aria-hidden="true"></div>
<div class="cursor-ring" id="aitr-cursor-ring" aria-hidden="true"></div>

<style>
	.cursor-dot,
	.cursor-ring {
		position: fixed;
		top: 0;
		left: 0;
		pointer-events: none;
		z-index: 10000;
		transition: opacity 0.2s ease;
		opacity: 0;
		will-change: transform;
	}
	.cursor-dot {
		width: 6px;
		height: 6px;
		background: linear-gradient(135deg, #c4b5fd, #f9a8d4);
		border-radius: 50%;
		box-shadow: 0 0 10px rgba(196, 181, 253, 0.6);
		transform: translate3d(-50%, -50%, 0);
	}
	.cursor-ring {
		width: 32px;
		height: 32px;
		border: 1.5px solid rgba(196, 181, 253, 0.5);
		border-radius: 50%;
		transform: translate3d(-50%, -50%, 0);
		transition: opacity 0.2s ease, width 0.25s ease, height 0.25s ease, border-color 0.25s ease;
	}
	.cursor-ring.hover {
		width: 56px;
		height: 56px;
		border-color: rgba(249, 168, 212, 0.8);
		background: rgba(139, 92, 246, 0.08);
	}
	.cursor-ring.click {
		width: 24px;
		height: 24px;
		border-color: rgba(139, 92, 246, 0.9);
	}
	@media (hover: none), (prefers-reduced-motion: reduce) {
		.cursor-dot,
		.cursor-ring {
			display: none !important;
		}
	}
</style>

<script is:inline>
	(function () {
		function setupCursor() {
			if (window.matchMedia && window.matchMedia('(hover: none)').matches) return;
			if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			var dot = document.getElementById('aitr-cursor-dot');
			var ring = document.getElementById('aitr-cursor-ring');
			if (!dot || !ring) return;
			if (document.body.dataset.cursorBound) return;
			document.body.dataset.cursorBound = '1';

			var mouseX = 0, mouseY = 0;
			var ringX = 0, ringY = 0;
			var visible = false;

			function move(e) {
				mouseX = e.clientX;
				mouseY = e.clientY;
				dot.style.transform = 'translate3d(' + (mouseX - 3) + 'px, ' + (mouseY - 3) + 'px, 0)';
				if (!visible) {
					dot.style.opacity = '1';
					ring.style.opacity = '1';
					visible = true;
				}
			}

			function animateRing() {
				ringX += (mouseX - ringX) * 0.18;
				ringY += (mouseY - ringY) * 0.18;
				ring.style.transform = 'translate3d(' + (ringX - 16) + 'px, ' + (ringY - 16) + 'px, 0)';
				requestAnimationFrame(animateRing);
			}

			document.addEventListener('mousemove', move);
			document.addEventListener('mouseleave', function () {
				dot.style.opacity = '0';
				ring.style.opacity = '0';
				visible = false;
			});
			document.addEventListener('mousedown', function () {
				ring.classList.add('click');
			});
			document.addEventListener('mouseup', function () {
				ring.classList.remove('click');
			});

			function isHoverable(el) {
				if (!el || !el.tagName) return false;
				var tag = el.tagName.toLowerCase();
				if (tag === 'a' || tag === 'button' || tag === 'input' || tag === 'textarea' || tag === 'select') return true;
				if (el.classList && (el.classList.contains('post-card') || el.classList.contains('cat-card') || el.classList.contains('tool-card') || el.classList.contains('clickable'))) return true;
				return false;
			}
			document.addEventListener('mouseover', function (e) {
				if (isHoverable(e.target) || isHoverable(e.target.parentElement)) {
					ring.classList.add('hover');
				} else {
					ring.classList.remove('hover');
				}
			});

			animateRing();
		}
		document.addEventListener('astro:page-load', setupCursor);
	})();
</script>
