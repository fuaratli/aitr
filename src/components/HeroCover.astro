---
import { CATEGORY_META, type CategoryKey } from '../lib/categories';

interface Props {
	title: string;
	category?: string;
	size?: 'large' | 'medium' | 'small';
}
const { title, category = 'karsilastirma', size = 'medium' } = Astro.props;
const meta =
	CATEGORY_META[(category as CategoryKey) || 'karsilastirma'] || CATEGORY_META.karsilastirma;

// Title-based hash so each article gets a unique-looking mesh
const seed = title.split('').reduce((acc, c) => acc + c.charCodeAt(0), 17);
const r1x = (seed * 7) % 50 + 10;
const r1y = (seed * 11) % 50 + 10;
const r2x = (seed * 13) % 50 + 30;
const r2y = (seed * 17) % 50 + 30;
const r3x = (seed * 19) % 50 + 20;
const r3y = (seed * 23) % 50 + 40;

const colorMap: Record<string, [string, string, string]> = {
	karsilastirma: ['#22d3ee', '#06b6d4', '#818cf8'],
	rehber: ['#22d3ee', '#06b6d4', '#818cf8'],
	inceleme: ['#06b6d4', '#3b82f6', '#22c55e'],
	'para-kazanma': ['#f97316', '#ea580c', '#22d3ee'],
};
const colors = colorMap[(category as string) || 'karsilastirma'] || colorMap.karsilastirma;
const meshStyle = `--c1:${colors[0]};--c2:${colors[1]};--c3:${colors[2]};--r1x:${r1x}%;--r1y:${r1y}%;--r2x:${r2x}%;--r2y:${r2y}%;--r3x:${r3x}%;--r3y:${r3y}%;`;
---

<div class={`hcover hcover-${size}`} style={meshStyle} role="img" aria-label={title}>
	<div class="hcover-bg" aria-hidden="true"></div>
	<div class="hcover-grid" aria-hidden="true"></div>
	<div class="hcover-glow" aria-hidden="true"></div>
	<svg class="hcover-deco" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
		<defs>
			<linearGradient id={`g-${seed}`} x1="0" y1="0" x2="1" y2="1">
				<stop offset="0%" stop-color={colors[0]} stop-opacity="0.7"></stop>
				<stop offset="50%" stop-color={colors[1]} stop-opacity="0.5"></stop>
				<stop offset="100%" stop-color={colors[2]} stop-opacity="0.7"></stop>
			</linearGradient>
		</defs>
		<circle cx="85" cy="20" r="22" fill={`url(#g-${seed})`} opacity="0.25"></circle>
		<circle cx="15" cy="85" r="18" fill={`url(#g-${seed})`} opacity="0.18"></circle>
		<rect x="60" y="60" width="35" height="35" rx="6" fill={`url(#g-${seed})`} opacity="0.12" transform={`rotate(${seed % 30}, 78, 78)`}></rect>
	</svg>
	<div class="hcover-content">
		<div class="hcover-top">
			<div class="hcover-badge" style={`background:${meta.gradient}`}>
				<span aria-hidden="true">{meta.emoji}</span>
			</div>
			<span class="hcover-cat">{meta.label}</span>
		</div>
		<div class="hcover-title">{title}</div>
		<div class="hcover-foot">
			<span class="hcover-mark">
				<svg viewBox="0 0 24 24" width="14" height="14" fill="none" aria-hidden="true">
					<path
						d="M12 2 L20 21 L17 21 L15.2 16.5 H8.8 L7 21 L4 21 Z M9.7 13.6 H14.3 L12 7.5 Z"
						fill="currentColor"
					></path>
					<circle cx="20.5" cy="3.5" r="1.5" fill="currentColor"></circle>
				</svg>
				<span class="hcover-brand">AITR<span class="hcover-tld">.tr</span></span>
			</span>
			<span class="hcover-dot" aria-hidden="true"></span>
			<span class="hcover-hint">Yapay zeka rehberi</span>
		</div>
	</div>
</div>

<style>
	.hcover {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: 16px;
		overflow: hidden;
		background: #0a0a0c;
		isolation: isolate;
		container-type: inline-size;
	}
	.hcover-bg {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at var(--r1x) var(--r1y), color-mix(in oklab, var(--c1), transparent 30%), transparent 45%),
			radial-gradient(circle at var(--r2x) var(--r2y), color-mix(in oklab, var(--c2), transparent 40%), transparent 50%),
			radial-gradient(circle at var(--r3x) var(--r3y), color-mix(in oklab, var(--c3), transparent 50%), transparent 55%),
			linear-gradient(135deg, #0a0a0c 0%, #16161a 100%);
		z-index: 0;
		filter: saturate(120%);
	}
	.hcover-grid {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
		background-size: 40px 40px;
		opacity: 0.6;
		z-index: 1;
		mask-image: radial-gradient(ellipse 100% 80% at 50% 40%, black 30%, transparent 90%);
		-webkit-mask-image: radial-gradient(ellipse 100% 80% at 50% 40%, black 30%, transparent 90%);
	}
	.hcover-glow {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 80% 60% at 50% 100%, rgba(34, 211, 238, 0.22), transparent 60%),
			radial-gradient(ellipse 60% 40% at 50% 0%, rgba(0, 0, 0, 0.35), transparent 60%);
		z-index: 2;
	}
	.hcover-deco {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 2;
	}
	.hcover-content {
		position: relative;
		z-index: 3;
		height: 100%;
		padding: 8% 8% 7% 8%;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 6%;
	}
	.hcover-top {
		display: flex;
		align-items: center;
		gap: 0.75em;
	}
	.hcover-badge {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 12px;
		font-size: 1.2rem;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
	}
	.hcover-cat {
		font-family: var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.7rem;
		font-weight: 700;
		color: rgba(255, 255, 255, 0.75);
		padding: 0.35em 0.85em;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 999px;
		backdrop-filter: blur(8px);
	}
	.hcover-title {
		color: white;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(1rem, 4cqi, 2rem);
		line-height: 1.15;
		letter-spacing: -0.025em;
		text-shadow: 0 2px 16px rgba(0, 0, 0, 0.45);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		max-width: 95%;
	}
	.hcover-foot {
		display: flex;
		align-items: center;
		gap: 0.65em;
		font-family: var(--font-display);
		font-size: 0.78rem;
		color: rgba(255, 255, 255, 0.55);
	}
	.hcover-mark {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		color: rgba(255, 255, 255, 0.9);
	}
	.hcover-brand {
		font-weight: 800;
		letter-spacing: -0.02em;
		color: rgba(255, 255, 255, 0.9);
	}
	.hcover-tld {
		-webkit-text-fill-color: rgba(255, 255, 255, 0.45);
		color: rgba(255, 255, 255, 0.45);
		font-weight: 600;
	}
	.hcover-dot {
		width: 3px;
		height: 3px;
		background: rgba(255, 255, 255, 0.4);
		border-radius: 50%;
	}

	/* SIZE VARIANTS */
	.hcover-large {
		aspect-ratio: 16 / 9;
	}
	.hcover-large .hcover-content {
		padding: 5% 6%;
	}
	.hcover-large .hcover-badge {
		width: 3.25rem;
		height: 3.25rem;
		font-size: 1.6rem;
		border-radius: 14px;
	}
	.hcover-large .hcover-cat {
		font-size: 0.78rem;
	}
	.hcover-large .hcover-title {
		font-size: clamp(1.4rem, 5cqi, 3.2rem);
	}
	.hcover-large .hcover-foot {
		font-size: 0.88rem;
	}

	.hcover-medium .hcover-content {
		padding: 7% 7%;
	}

	.hcover-small {
		aspect-ratio: 16 / 9;
		border-radius: 12px;
	}
	.hcover-small .hcover-content {
		padding: 1em 1.2em;
	}
	.hcover-small .hcover-badge {
		width: 2rem;
		height: 2rem;
		font-size: 1rem;
		border-radius: 8px;
	}
	.hcover-small .hcover-cat {
		font-size: 0.62rem;
		padding: 0.25em 0.65em;
	}
	.hcover-small .hcover-title {
		font-size: clamp(0.85rem, 3.5cqi, 1.2rem);
		-webkit-line-clamp: 2;
	}
	.hcover-small .hcover-foot {
		font-size: 0.65rem;
	}
	.hcover-small .hcover-grid {
		background-size: 28px 28px;
	}
</style>
