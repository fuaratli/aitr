---
interface Props {
	variant?: 'inline' | 'section';
}
const { variant = 'section' } = Astro.props;
---

<section class={`newsletter newsletter-${variant}`} aria-label="Bülten aboneliği">
	<div class="inner">
		<div class="badge">📬 BÜLTEN</div>
		<h2>
			Yapay zeka dünyasını <span class="gradient-text">kaçırma</span>
		</h2>
		<p class="lede">
			Haftada bir e-posta. En önemli AI gelişmeleri, yeni rehberler, dürüst incelemeler. Spam yok,
			istediğin zaman çıkış yapabilirsin.
		</p>
		<form class="form" data-newsletter-form>
			<input
				type="email"
				placeholder="senin@email.com"
				aria-label="E-posta adresin"
				required
				data-newsletter-input
			/>
			<button type="submit" class="submit-btn">
				Abone Ol
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
			</button>
		</form>
		<p class="proof">
			<span class="proof-dot"></span> 2.400+ AI meraklısı zaten abone
		</p>
	</div>
</section>

<style>
	.newsletter {
		position: relative;
		overflow: hidden;
	}
	.newsletter-section {
		max-width: 1100px;
		margin: 0 auto;
		padding: 3em 1.25em;
	}
	.newsletter-inline {
		margin: 2em auto;
		padding: 0 1.25em;
		max-width: 760px;
	}
	.inner {
		position: relative;
		padding: 2.5em 2em;
		background: var(--surface);
		border: 1px solid var(--border-2);
		border-radius: 20px;
		text-align: center;
		overflow: hidden;
	}
	.inner::before {
		content: '';
		position: absolute;
		top: -50%;
		left: -50%;
		width: 200%;
		height: 200%;
		background:
			radial-gradient(circle at 30% 40%, rgba(34, 211, 238, 0.1), transparent 40%),
			radial-gradient(circle at 70% 60%, rgba(34, 211, 238, 0.08), transparent 40%);
		filter: blur(40px);
		opacity: 0.7;
		z-index: 0;
		pointer-events: none;
	}
	.inner > * {
		position: relative;
		z-index: 1;
	}
	.badge {
		display: inline-block;
		font-size: 0.7em;
		letter-spacing: 0.18em;
		color: var(--accent);
		font-weight: 700;
		font-family: var(--font-display);
		padding: 0.35em 0.85em;
		background: var(--surface-2);
		border: 1px solid var(--border-glow);
		border-radius: 999px;
		margin-bottom: 1.25em;
	}
	.newsletter h2 {
		font-size: clamp(1.6em, 4vw, 2.2em);
		margin: 0 0 0.5em 0;
		letter-spacing: -0.02em;
	}
	.lede {
		color: var(--text-muted);
		max-width: 540px;
		margin: 0 auto 1.5em auto;
		font-size: 1em;
		line-height: 1.6;
	}
	.form {
		display: flex;
		gap: 0.5em;
		max-width: 460px;
		margin: 0 auto 1em auto;
		flex-wrap: wrap;
		justify-content: center;
	}
	.form input {
		flex: 1;
		min-width: 200px;
		padding: 0.85em 1.1em;
		background: rgba(7, 7, 13, 0.7);
		border: 1px solid var(--border-2);
		border-radius: 10px;
		color: var(--text);
		font-size: 0.95em;
		transition: 0.2s ease;
	}
	.form input:focus {
		outline: none;
		border-color: var(--accent);
		box-shadow: 0 0 0 3px var(--accent-glow);
	}
	.submit-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.85em 1.4em;
		background: var(--lime);
		color: var(--lime-ink);
		border: none;
		border-radius: 10px;
		font-weight: 600;
		font-size: 0.95em;
		cursor: pointer;
		font-family: var(--font-display);
		transition: 0.2s ease;
	}
	.submit-btn:hover {
		transform: translateY(-1px);
		box-shadow: var(--shadow-card-hover);
	}
	.proof {
		color: var(--text-muted);
		font-size: 0.85em;
		margin: 0;
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		justify-content: center;
	}
	.proof-dot {
		width: 8px;
		height: 8px;
		background: var(--success);
		border-radius: 50%;
		box-shadow: 0 0 8px var(--success);
		animation: pulse-dot-green 1.8s ease-in-out infinite;
	}
	@keyframes pulse-dot-green {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.5; }
	}
	.success-msg {
		color: var(--success);
		font-weight: 600;
		padding: 1em;
	}
	@media (max-width: 600px) {
		.inner {
			padding: 2em 1.25em;
		}
		.form input,
		.submit-btn {
			width: 100%;
		}
	}
</style>

<script is:inline>
	(function () {
		function setupNewsletter() {
			document.querySelectorAll('[data-newsletter-form]').forEach(function (form) {
				if (form.dataset.bound) return;
				form.dataset.bound = '1';
				form.addEventListener('submit', function (e) {
					e.preventDefault();
					var input = form.querySelector('[data-newsletter-input]');
					if (!input || !input.value) return;
					var email = input.value.trim();
					try {
						localStorage.setItem('aitr-newsletter-pending', email);
					} catch (err) {}
					form.innerHTML =
						'<p class="success-msg">✓ Teşekkürler! İlk bülten geldiğinde haberin olacak.</p>';
				});
			});
		}
		document.addEventListener('astro:page-load', setupNewsletter);
	})();
</script>
