---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { CATEGORY_META, type CategoryKey } from '../lib/categories';

interface Props {
	posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
---

{
	posts.length > 0 && (
		<section class="related" aria-labelledby="related-title">
			<header class="head">
				<h2 id="related-title">Belki bunlar da ilgini çeker</h2>
				<p>Aynı dünyadan, dikkatle hazırlanmış diğer yazılar.</p>
			</header>
			<ul class="grid">
				{posts.map((p) => {
					const meta = CATEGORY_META[p.data.category as CategoryKey];
					return (
						<li class="card">
							<a href={`/blog/${p.id}/`}>
								{p.data.heroImage && (
									<div class="img">
										<Image width={400} height={220} src={p.data.heroImage} alt={p.data.title} />
									</div>
								)}
								<div class="body">
									<span class="pill" style={meta ? `background:${meta.gradient}` : ''}>
										{meta?.emoji} {meta?.label ?? 'Yazı'}
									</span>
									<h3>{p.data.title}</h3>
									<p class="date">
										<FormattedDate date={p.data.pubDate} />
									</p>
								</div>
							</a>
						</li>
					);
				})}
			</ul>
		</section>
	)
}

<style>
	.related {
		max-width: 1100px;
		margin: 3em auto;
		padding: 0 1.25em;
	}
	.head {
		text-align: center;
		margin-bottom: 1.75em;
	}
	.head h2 {
		font-size: clamp(1.5em, 3.5vw, 2em);
		margin: 0 0 0.35em 0;
		letter-spacing: -0.02em;
	}
	.head p {
		margin: 0;
		color: var(--text-muted);
	}
	.grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.25em;
	}
	.card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 14px;
		overflow: hidden;
		transition: 0.25s ease;
		backdrop-filter: blur(10px);
	}
	.card:hover {
		border-color: var(--border-glow);
		transform: translateY(-3px);
		box-shadow: var(--shadow-card-hover);
	}
	.card a {
		text-decoration: none;
		color: var(--text);
		display: block;
		height: 100%;
	}
	.img {
		overflow: hidden;
		background: var(--bg-2);
	}
	.img img {
		display: block;
		width: 100%;
		height: 160px;
		object-fit: cover;
		transition: transform 0.4s ease;
		border-radius: 0;
	}
	.card:hover .img img {
		transform: scale(1.05);
	}
	.body {
		padding: 1em 1.1em 1.1em;
	}
	.pill {
		display: inline-block;
		font-size: 0.75em;
		padding: 0.25em 0.7em;
		border-radius: 999px;
		color: white;
		font-weight: 600;
		margin-bottom: 0.6em;
	}
	.body h3 {
		font-size: 1.05em;
		line-height: 1.3;
		margin: 0 0 0.4em 0;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.date {
		margin: 0;
		font-size: 0.8em;
		color: var(--text-dim);
	}
</style>
