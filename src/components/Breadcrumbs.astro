---
interface Crumb {
	label: string;
	href?: string;
}
interface Props {
	items: Crumb[];
}
const { items } = Astro.props;

const schema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: items.map((c, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		name: c.label,
		...(c.href && { item: new URL(c.href, Astro.site).toString() }),
	})),
};
---

<nav class="crumbs" aria-label="Sayfa konumu">
	<ol>
		{
			items.map((c, i) => (
				<li>
					{c.href && i < items.length - 1 ? (
						<a href={c.href}>{c.label}</a>
					) : (
						<span aria-current="page">{c.label}</span>
					)}
					{i < items.length - 1 && (
						<span class="sep" aria-hidden="true">
							/
						</span>
					)}
				</li>
			))
		}
	</ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

<style>
	.crumbs {
		max-width: 1100px;
		margin: 1em auto 0;
		padding: 0 1.25em;
		font-size: 0.85em;
		color: var(--text-muted);
	}
	.crumbs ol {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
	}
	.crumbs li {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
	}
	.crumbs a {
		color: var(--text-muted);
		text-decoration: none;
		transition: 0.15s ease;
	}
	.crumbs a:hover {
		color: #c4b5fd;
	}
	.sep {
		color: var(--text-dim);
	}
	[aria-current='page'] {
		color: var(--text);
	}
</style>
