---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav class="container">
		<a href="/" class="brand" aria-label="AITR anasayfa">
			<span class="brand-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="none">
					<path
						d="M12 2 L20 21 L17 21 L15.2 16.5 H8.8 L7 21 L4 21 Z M9.7 13.6 H14.3 L12 7.5 Z"
						fill="white"
					></path>
					<circle cx="20.5" cy="3.5" r="1.5" fill="white"></circle>
				</svg>
			</span>
			<span class="brand-text">AITR</span>
			<span class="brand-tag">.tr</span>
		</a>
		<div class="links">
			<HeaderLink href="/">Anasayfa</HeaderLink>
			<HeaderLink href="/blog">Yazılar</HeaderLink>
			<HeaderLink href="/about">Hakkında</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(7, 7, 13, 0.65);
		backdrop-filter: saturate(180%) blur(16px);
		-webkit-backdrop-filter: saturate(180%) blur(16px);
		border-bottom: 1px solid var(--border);
	}
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.85em 1.25em;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		text-decoration: none;
		font-family: var(--font-display);
		letter-spacing: -0.02em;
		flex-shrink: 0;
	}
	.brand-icon {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		background: var(--gradient-1);
		border-radius: 9px;
		box-shadow: var(--glow-violet);
	}
	.brand-text {
		font-weight: 800;
		font-size: 1.15em;
		background: var(--gradient-text);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		color: transparent;
	}
	.brand-tag {
		font-weight: 600;
		font-size: 0.95em;
		color: var(--text-dim);
	}
	.links {
		display: flex;
		align-items: center;
		gap: 0.25em;
	}
	.links :global(a) {
		padding: 0.55em 0.95em;
		color: var(--text-muted);
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95em;
		border-radius: 8px;
		transition: 0.15s ease;
	}
	.links :global(a:hover),
	.links :global(a.active) {
		color: var(--text);
		background: var(--surface-2);
	}
	@media (max-width: 540px) {
		.brand-tag {
			display: none;
		}
		.links :global(a) {
			padding: 0.5em 0.65em;
			font-size: 0.9em;
		}
	}
</style>
