---
import HeaderLink from './HeaderLink.astro';
---

<header transition:persist transition:name="site-header">
	<nav class="container">
		<a href="/" class="brand" aria-label="AITR anasayfa">
			<span class="brand-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="none">
					<path
						d="M12 2 L20 21 L17 21 L15.2 16.5 H8.8 L7 21 L4 21 Z M9.7 13.6 H14.3 L12 7.5 Z"
						fill="white"
					></path>
					<circle cx="20.5" cy="3.5" r="1.5" fill="white"></circle>
				</svg>
			</span>
			<span class="brand-text">AITR</span>
			<span class="brand-tag">.tr</span>
		</a>

		<button
			class="hamburger"
			id="aitr-hamburger"
			aria-label="Menüyü aç"
			aria-expanded="false"
			aria-controls="aitr-nav"
			type="button"
		>
			<span></span>
			<span></span>
			<span></span>
		</button>

		<div class="links" id="aitr-nav">
			<HeaderLink href="/">Anasayfa</HeaderLink>
			<HeaderLink href="/blog">Yazılar</HeaderLink>
			<div class="dropdown">
				<button class="dropdown-trigger" aria-haspopup="true" aria-expanded="false">
					Kategoriler
					<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
				</button>
				<div class="dropdown-menu">
					<a href="/blog/kategori/karsilastirmalar/">⚖️ Karşılaştırmalar</a>
					<a href="/blog/kategori/rehberler/">📘 Kullanım Rehberleri</a>
					<a href="/blog/kategori/incelemeler/">🔍 İncelemeler</a>
					<a href="/blog/kategori/para-kazanma/">💼 Para Kazanma</a>
				</div>
			</div>
			<HeaderLink href="/about">Hakkında</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(7, 7, 13, 0.7);
		backdrop-filter: saturate(180%) blur(18px);
		-webkit-backdrop-filter: saturate(180%) blur(18px);
		border-bottom: 1px solid var(--border);
	}
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.75em 1.25em;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		text-decoration: none;
		font-family: var(--font-display);
		letter-spacing: -0.02em;
		flex-shrink: 0;
		transition: 0.2s ease;
	}
	.brand:hover {
		transform: translateY(-1px);
	}
	.brand-icon {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		background: var(--gradient-1);
		border-radius: 9px;
		box-shadow: var(--glow-violet);
	}
	.brand-text {
		font-weight: 800;
		font-size: 1.15em;
		background: var(--gradient-text);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		color: transparent;
	}
	.brand-tag {
		font-weight: 600;
		font-size: 0.95em;
		color: var(--text-dim);
	}

	.hamburger {
		display: none;
		background: transparent;
		border: 1px solid var(--border-2);
		border-radius: 8px;
		padding: 0;
		width: 38px;
		height: 38px;
		cursor: pointer;
		position: relative;
	}
	.hamburger span {
		position: absolute;
		left: 9px;
		right: 9px;
		height: 2px;
		background: var(--text);
		border-radius: 2px;
		transition: 0.25s ease;
	}
	.hamburger span:nth-child(1) { top: 12px; }
	.hamburger span:nth-child(2) { top: 50%; transform: translateY(-50%); }
	.hamburger span:nth-child(3) { bottom: 12px; }
	.hamburger[aria-expanded='true'] span:nth-child(1) {
		top: 50%;
		transform: translateY(-50%) rotate(45deg);
	}
	.hamburger[aria-expanded='true'] span:nth-child(2) {
		opacity: 0;
	}
	.hamburger[aria-expanded='true'] span:nth-child(3) {
		bottom: auto;
		top: 50%;
		transform: translateY(-50%) rotate(-45deg);
	}

	.links {
		display: flex;
		align-items: center;
		gap: 0.25em;
	}
	.links :global(a) {
		padding: 0.55em 0.95em;
		color: var(--text-muted);
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95em;
		border-radius: 8px;
		transition: 0.15s ease;
	}
	.links :global(a:hover),
	.links :global(a.active) {
		color: var(--text);
		background: var(--surface-2);
	}

	.dropdown {
		position: relative;
	}
	.dropdown-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		padding: 0.55em 0.95em;
		background: transparent;
		border: none;
		color: var(--text-muted);
		font-size: 0.95em;
		font-weight: 500;
		font-family: inherit;
		cursor: pointer;
		border-radius: 8px;
		transition: 0.15s ease;
	}
	.dropdown-trigger:hover {
		color: var(--text);
		background: var(--surface-2);
	}
	.dropdown-menu {
		position: absolute;
		top: calc(100% + 8px);
		left: 0;
		min-width: 220px;
		background: rgba(12, 12, 24, 0.95);
		border: 1px solid var(--border-2);
		border-radius: 12px;
		padding: 0.5em;
		backdrop-filter: blur(16px);
		opacity: 0;
		pointer-events: none;
		transform: translateY(-6px);
		transition: 0.2s ease;
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
	}
	.dropdown:hover .dropdown-menu,
	.dropdown:focus-within .dropdown-menu {
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0);
	}
	.dropdown-menu a {
		display: block;
		padding: 0.65em 0.85em;
		color: var(--text-muted);
		text-decoration: none;
		border-radius: 8px;
		font-size: 0.92em;
		transition: 0.15s ease;
	}
	.dropdown-menu a:hover {
		background: var(--surface-2);
		color: var(--text);
	}

	@media (max-width: 820px) {
		.hamburger {
			display: block;
		}
		.links {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 0.25em;
			padding: 1em 1.25em 1.5em;
			background: rgba(7, 7, 13, 0.97);
			border-bottom: 1px solid var(--border);
			backdrop-filter: blur(20px);
			max-height: 0;
			overflow: hidden;
			transition: max-height 0.3s ease, padding 0.3s ease;
			padding-top: 0;
			padding-bottom: 0;
		}
		.links.open {
			max-height: 80vh;
			padding-top: 1em;
			padding-bottom: 1.5em;
		}
		.links :global(a),
		.dropdown-trigger {
			width: 100%;
			text-align: left;
			padding: 0.85em 1em;
			font-size: 1.05em;
		}
		.dropdown {
			width: 100%;
		}
		.dropdown-menu {
			position: static;
			opacity: 1;
			pointer-events: auto;
			transform: none;
			background: transparent;
			border: none;
			box-shadow: none;
			padding-left: 1.5em;
			min-width: 0;
		}
	}
</style>

<script is:inline>
	(function () {
		function setupNav() {
			var btn = document.getElementById('aitr-hamburger');
			var nav = document.getElementById('aitr-nav');
			if (!btn || !nav) return;
			if (btn.dataset.bound) return;
			btn.dataset.bound = '1';
			btn.addEventListener('click', function () {
				var open = btn.getAttribute('aria-expanded') === 'true';
				btn.setAttribute('aria-expanded', String(!open));
				nav.classList.toggle('open', !open);
				btn.setAttribute('aria-label', !open ? 'Menüyü kapat' : 'Menüyü aç');
			});
			nav.querySelectorAll('a').forEach(function (a) {
				a.addEventListener('click', function () {
					if (window.innerWidth <= 820) {
						btn.setAttribute('aria-expanded', 'false');
						nav.classList.remove('open');
					}
				});
			});
		}
		document.addEventListener('astro:page-load', setupNav);
	})();
</script>
