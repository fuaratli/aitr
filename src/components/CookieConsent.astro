<div class="cookie-banner" id="cookie-banner" hidden role="dialog" aria-label="Çerez bildirimi">
	<div class="inner">
		<p>
			🍪 Bu site deneyimini iyileştirmek için çerez kullanır. Devam ederek kabul etmiş olursun.
			<a href="/gizlilik/">Gizlilik Politikası</a>
		</p>
		<button class="accept" id="cookie-accept" type="button">Tamam, anladım</button>
	</div>
</div>

<style>
	.cookie-banner {
		position: fixed;
		left: 1em;
		right: 1em;
		bottom: 1em;
		max-width: 720px;
		margin: 0 auto;
		padding: 1em 1.25em;
		background: rgba(12, 12, 24, 0.92);
		border: 1px solid var(--border-2);
		border-radius: 14px;
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		z-index: 95;
		box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
		animation: cookie-slide 0.4s ease both;
	}
	.cookie-banner[hidden] {
		display: none !important;
	}
	@keyframes cookie-slide {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	.inner {
		display: flex;
		align-items: center;
		gap: 1em;
		flex-wrap: wrap;
		justify-content: space-between;
	}
	.inner p {
		margin: 0;
		font-size: 0.92em;
		color: var(--text-muted);
		flex: 1;
		min-width: 200px;
	}
	.inner p a {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.accept {
		padding: 0.55em 1.1em;
		border-radius: 999px;
		border: none;
		background: var(--accent-strong);
		color: white;
		font-weight: 600;
		font-size: 0.9em;
		cursor: pointer;
		transition: 0.2s ease;
		font-family: var(--font-display);
	}
	.accept:hover {
		transform: translateY(-1px);
		box-shadow: var(--shadow-card-hover);
	}
</style>

<script is:inline>
	(function () {
		function setupCookie() {
			var banner = document.getElementById('cookie-banner');
			var accept = document.getElementById('cookie-accept');
			if (!banner || !accept) return;
			try {
				if (localStorage.getItem('aitr-cookie-ok')) return;
			} catch (e) {}
			banner.hidden = false;
			accept.onclick = function () {
				try {
					localStorage.setItem('aitr-cookie-ok', '1');
				} catch (e) {}
				banner.hidden = true;
			};
		}
		document.addEventListener('astro:page-load', setupCookie);
	})();
</script>
