<button class="theme-toggle" id="aitr-theme-toggle" aria-label="Tema değiştir" type="button">
	<svg class="icon sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
	</svg>
	<svg class="icon moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
	</svg>
</button>

<style>
	.theme-toggle {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 10px;
		color: var(--text-muted);
		cursor: pointer;
		transition: 0.15s ease;
		position: relative;
	}
	.theme-toggle:hover {
		color: var(--text);
		border-color: var(--border-glow);
		background: var(--surface-2);
	}
	.theme-toggle .icon {
		position: absolute;
		transition: 0.3s ease;
	}
	:global([data-theme='dark']) .theme-toggle .sun,
	:global(:not([data-theme='light'])) .theme-toggle .sun {
		opacity: 1;
		transform: rotate(0);
	}
	:global([data-theme='dark']) .theme-toggle .moon,
	:global(:not([data-theme='light'])) .theme-toggle .moon {
		opacity: 0;
		transform: rotate(-90deg);
	}
	:global([data-theme='light']) .theme-toggle .sun {
		opacity: 0;
		transform: rotate(90deg);
	}
	:global([data-theme='light']) .theme-toggle .moon {
		opacity: 1;
		transform: rotate(0);
	}
</style>

<script is:inline>
	(function () {
		function setupTheme() {
			var btn = document.getElementById('aitr-theme-toggle');
			if (!btn) return;
			if (btn.dataset.bound) return;
			btn.dataset.bound = '1';
			btn.addEventListener('click', function () {
				var current = document.documentElement.getAttribute('data-theme') || 'dark';
				var next = current === 'dark' ? 'light' : 'dark';
				document.documentElement.setAttribute('data-theme', next);
				try {
					localStorage.setItem('aitr-theme', next);
				} catch (e) {}
			});
		}
		document.addEventListener('astro:page-load', setupTheme);
	})();
</script>
