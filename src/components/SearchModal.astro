<button class="search-trigger" id="aitr-search-trigger" aria-label="Arama (Ctrl+K)" type="button">
	<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="11" cy="11" r="8"></circle>
		<path d="m21 21-4.3-4.3"></path>
	</svg>
	<span class="search-trigger-text">Ara</span>
	<kbd>Ctrl K</kbd>
</button>

<div class="search-modal" id="aitr-search-modal" hidden role="dialog" aria-modal="true" aria-label="Site içi arama">
	<div class="modal-bg" id="aitr-search-bg" aria-hidden="true"></div>
	<div class="modal-panel">
		<div class="modal-head">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="11" cy="11" r="8"></circle>
				<path d="m21 21-4.3-4.3"></path>
			</svg>
			<input
				type="text"
				id="aitr-search-input"
				placeholder="Yazıları ara — örn. chatgpt, midjourney, para kazanma"
				aria-label="Arama"
				autocomplete="off"
				spellcheck="false"
			/>
			<button class="close-btn" id="aitr-search-close" aria-label="Kapat" type="button">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M18 6 6 18M6 6l12 12"></path>
				</svg>
			</button>
		</div>
		<div class="modal-body" id="aitr-search-results">
			<p class="hint">Aramaya başlamak için yaz. <kbd>Esc</kbd> ile kapat.</p>
		</div>
		<div class="modal-foot">
			<span><kbd>↑</kbd><kbd>↓</kbd> dolaş</span>
			<span><kbd>↵</kbd> aç</span>
			<span><kbd>Esc</kbd> kapat</span>
		</div>
	</div>
</div>

<style>
	.search-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.5em 0.8em;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 10px;
		color: var(--text-muted);
		font-family: inherit;
		font-size: 0.85em;
		cursor: pointer;
		transition: 0.15s ease;
	}
	.search-trigger:hover {
		color: var(--text);
		border-color: var(--border-glow);
		background: var(--surface-2);
	}
	.search-trigger kbd {
		display: inline-block;
		padding: 0.1em 0.4em;
		background: var(--surface-2);
		border: 1px solid var(--border);
		border-radius: 4px;
		font-size: 0.75em;
		font-family: var(--font-mono);
		color: var(--text-dim);
	}
	@media (max-width: 720px) {
		.search-trigger-text,
		.search-trigger kbd {
			display: none;
		}
		.search-trigger {
			padding: 0.5em;
		}
	}

	.search-modal {
		position: fixed;
		inset: 0;
		z-index: 200;
		display: grid;
		place-items: start center;
		padding: 8vh 1em 1em;
		animation: fade-in 0.2s ease;
	}
	.search-modal[hidden] {
		display: none !important;
	}
	@keyframes fade-in {
		from { opacity: 0; }
		to { opacity: 1; }
	}
	.modal-bg {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.65);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}
	.modal-panel {
		position: relative;
		width: 100%;
		max-width: 640px;
		background: var(--bg-elevated);
		border: 1px solid var(--border-2);
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 24px 80px rgba(0, 0, 0, 0.6);
		animation: pop-in 0.25s ease;
	}
	@keyframes pop-in {
		from { opacity: 0; transform: translateY(-12px) scale(0.98); }
		to { opacity: 1; transform: translateY(0) scale(1); }
	}
	.modal-head {
		display: flex;
		align-items: center;
		gap: 0.75em;
		padding: 1em 1.25em;
		border-bottom: 1px solid var(--border);
		color: var(--text-muted);
	}
	.modal-head input {
		flex: 1;
		background: transparent;
		border: none;
		padding: 0.25em 0;
		color: var(--text);
		font-size: 1.05em;
		outline: none;
	}
	.close-btn {
		background: var(--surface);
		border: 1px solid var(--border);
		color: var(--text-muted);
		padding: 0.4em;
		border-radius: 6px;
		cursor: pointer;
		display: grid;
		place-items: center;
		transition: 0.15s ease;
	}
	.close-btn:hover {
		color: var(--text);
		background: var(--surface-2);
	}
	.modal-body {
		max-height: 60vh;
		overflow-y: auto;
		padding: 0.5em;
	}
	.modal-body .hint {
		text-align: center;
		color: var(--text-dim);
		padding: 2em 1em;
		margin: 0;
		font-size: 0.95em;
	}
	.modal-body .hint kbd,
	.modal-foot kbd {
		display: inline-block;
		padding: 0.1em 0.45em;
		background: var(--surface-2);
		border: 1px solid var(--border);
		border-radius: 4px;
		font-family: var(--font-mono);
		font-size: 0.8em;
		color: var(--text-muted);
	}
	.modal-body :global(.result) {
		display: block;
		padding: 0.75em 1em;
		border-radius: 10px;
		color: var(--text);
		text-decoration: none;
		transition: 0.12s ease;
	}
	.modal-body :global(.result + .result) {
		margin-top: 0.25em;
	}
	.modal-body :global(.result:hover),
	.modal-body :global(.result.active) {
		background: var(--surface-2);
	}
	.modal-body :global(.result h4) {
		margin: 0 0 0.2em 0;
		font-size: 0.98em;
		font-family: var(--font-display);
	}
	.modal-body :global(.result p) {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.85em;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.modal-body :global(.result .badge) {
		display: inline-block;
		font-size: 0.7em;
		padding: 0.15em 0.5em;
		border-radius: 999px;
		background: var(--lime);
		color: var(--lime-ink);
		margin-bottom: 0.35em;
		font-weight: 600;
	}
	.modal-body :global(.empty) {
		text-align: center;
		color: var(--text-dim);
		padding: 2em 1em;
		margin: 0;
	}
	.modal-foot {
		display: flex;
		gap: 1em;
		padding: 0.75em 1.25em;
		border-top: 1px solid var(--border);
		font-size: 0.78em;
		color: var(--text-dim);
		flex-wrap: wrap;
	}
	.modal-foot span {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
	}
</style>

<script is:inline>
	(function () {
		var CATS = {
			karsilastirma: 'Karşılaştırma',
			rehber: 'Rehber',
			inceleme: 'İnceleme',
			'para-kazanma': 'Para Kazanma',
		};
		var posts = null;
		var fetching = null;

		function loadIndex() {
			if (posts) return Promise.resolve(posts);
			if (fetching) return fetching;
			fetching = fetch('/search.json')
				.then(function (r) {
					return r.json();
				})
				.then(function (data) {
					posts = data;
					return posts;
				})
				.catch(function () {
					posts = [];
					return posts;
				});
			return fetching;
		}

		function render(query, results) {
			if (!query.trim()) {
				results.innerHTML = '<p class="hint">Aramaya başlamak için yaz. <kbd>Esc</kbd> ile kapat.</p>';
				return;
			}
			if (!posts || posts.length === 0) {
				results.innerHTML = '<p class="empty">Yükleniyor…</p>';
				return;
			}
			var q = query.toLowerCase();
			var matches = posts
				.filter(function (p) {
					if (p.title.toLowerCase().indexOf(q) !== -1) return true;
					if (p.description.toLowerCase().indexOf(q) !== -1) return true;
					if (p.tags && p.tags.some(function (t) { return t.toLowerCase().indexOf(q) !== -1; })) return true;
					return false;
				})
				.slice(0, 10);
			if (matches.length === 0) {
				results.innerHTML = '<p class="empty">Hiçbir sonuç yok. Farklı bir kelime dene.</p>';
				return;
			}
			results.innerHTML = matches
				.map(function (p, i) {
					return (
						'<a class="result' +
						(i === 0 ? ' active' : '') +
						'" href="/blog/' +
						p.slug +
						'/"><span class="badge">' +
						(CATS[p.category] || 'Yazı') +
						'</span><h4>' +
						escapeHtml(p.title) +
						'</h4><p>' +
						escapeHtml(p.description) +
						'</p></a>'
					);
				})
				.join('');
		}

		function escapeHtml(s) {
			return s.replace(/[&<>"']/g, function (c) {
				return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
			});
		}

		function setupSearch() {
			var trigger = document.getElementById('aitr-search-trigger');
			var modal = document.getElementById('aitr-search-modal');
			var bg = document.getElementById('aitr-search-bg');
			var input = document.getElementById('aitr-search-input');
			var closeBtn = document.getElementById('aitr-search-close');
			var results = document.getElementById('aitr-search-results');
			if (!trigger || !modal || !input || !results) return;
			if (trigger.dataset.bound) return;
			trigger.dataset.bound = '1';

			function open() {
				modal.hidden = false;
				document.body.style.overflow = 'hidden';
				setTimeout(function () { input.focus(); }, 50);
				loadIndex();
			}
			function close() {
				modal.hidden = true;
				document.body.style.overflow = '';
				input.value = '';
				render('', results);
			}
			function moveActive(delta) {
				var items = results.querySelectorAll('.result');
				if (!items.length) return;
				var idx = -1;
				items.forEach(function (el, i) { if (el.classList.contains('active')) idx = i; });
				if (idx === -1) idx = 0;
				items[idx].classList.remove('active');
				idx = (idx + delta + items.length) % items.length;
				items[idx].classList.add('active');
				items[idx].scrollIntoView({ block: 'nearest' });
			}

			trigger.onclick = open;
			bg.onclick = close;
			closeBtn.onclick = close;
			input.oninput = function (e) {
				render(e.target.value, results);
			};
			modal.onkeydown = function (e) {
				if (e.key === 'ArrowDown') {
					e.preventDefault();
					moveActive(1);
				} else if (e.key === 'ArrowUp') {
					e.preventDefault();
					moveActive(-1);
				} else if (e.key === 'Enter') {
					var active = results.querySelector('.result.active');
					if (active) {
						e.preventDefault();
						window.location.href = active.getAttribute('href');
					}
				}
			};
			document.addEventListener('keydown', function (e) {
				if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
					e.preventDefault();
					if (modal.hidden) open();
					else close();
				}
				if (e.key === 'Escape' && !modal.hidden) close();
			});
		}
		document.addEventListener('astro:page-load', setupSearch);
	})();
</script>
