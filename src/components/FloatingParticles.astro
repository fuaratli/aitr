---
interface Props {
	count?: number;
}
const { count = 18 } = Astro.props;
const particles = Array.from({ length: count }, (_, i) => i);
---

<div class="particles" aria-hidden="true">
	{
		particles.map((i) => {
			const left = Math.random() * 100;
			const size = 2 + Math.random() * 4;
			const duration = 14 + Math.random() * 20;
			const delay = -Math.random() * 30;
			const opacity = 0.25 + Math.random() * 0.4;
			return (
				<span
					class="particle"
					style={`left:${left}%;width:${size}px;height:${size}px;animation-duration:${duration}s;animation-delay:${delay}s;opacity:${opacity};`}
				/>
			);
		})
	}
</div>

<style>
	.particles {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		z-index: 1;
	}
	.particle {
		position: absolute;
		bottom: -10px;
		border-radius: 50%;
		background: radial-gradient(circle, #c4b5fd 0%, transparent 70%);
		animation-name: particle-float;
		animation-iteration-count: infinite;
		animation-timing-function: linear;
		will-change: transform, opacity;
		filter: blur(0.5px);
	}
	.particle:nth-child(3n) {
		background: radial-gradient(circle, #f9a8d4 0%, transparent 70%);
	}
	.particle:nth-child(5n) {
		background: radial-gradient(circle, #93c5fd 0%, transparent 70%);
	}
	@keyframes particle-float {
		0% {
			transform: translateY(0) translateX(0);
			opacity: 0;
		}
		10% {
			opacity: 1;
		}
		50% {
			transform: translateY(-50vh) translateX(20px);
		}
		90% {
			opacity: 0.5;
		}
		100% {
			transform: translateY(-100vh) translateX(-20px);
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.particle {
			display: none;
		}
	}
</style>
