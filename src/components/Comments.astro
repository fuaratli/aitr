---
interface Props {
	slug: string;
}
const { slug } = Astro.props;

// GISCUS yapılandırması
// Aktif etmek için:
//   1) GitHub repo'da Discussions'ı aç (Settings → Features → Discussions)
//   2) github.com/apps/giscus → Install → aitr repo'sunu seç
//   3) giscus.app → "fuaratli/aitr" ve "General" kategorisi seç
//   4) Aşağıdaki REPO_ID ve CATEGORY_ID değerlerini giscus.app'in verdikleriyle değiştir
const REPO = 'fuaratli/aitr';
const REPO_ID = '';
const CATEGORY = 'General';
const CATEGORY_ID = '';
const giscusReady = REPO_ID && CATEGORY_ID;
---

<section class="comments-wrap" aria-label="Yorumlar">
	<header class="comments-head">
		<h2>💬 Yorumlar</h2>
		<p>
			Düşüncelerini paylaş, başkalarının yorumlarını oku. GitHub hesabınla giriş yapman yeterli.
		</p>
	</header>

	{
		giscusReady ? (
			<div class="giscus-container">
				<script
					src="https://giscus.app/client.js"
					data-repo={REPO}
					data-repo-id={REPO_ID}
					data-category={CATEGORY}
					data-category-id={CATEGORY_ID}
					data-mapping="pathname"
					data-strict="0"
					data-reactions-enabled="1"
					data-emit-metadata="0"
					data-input-position="top"
					data-theme="dark"
					data-lang="tr"
					data-loading="lazy"
					crossorigin="anonymous"
					async
				/>
			</div>
		) : (
			<div class="comments-placeholder">
				<div class="ph-icon" aria-hidden="true">💬</div>
				<h3>Yorumlar yakında aktif</h3>
				<p>
					Yorum sistemi kurulum aşamasında. Şu an için fikirlerini
					<a href="/iletisim/">iletişim formu</a> üzerinden paylaşabilirsin.
				</p>
				<div class="ph-actions">
					<a href="/iletisim/" class="btn btn-ghost">Bize Yaz</a>
					<a href={`https://twitter.com/intent/tweet?text=AITR'da%20yeni%20bir%20yaz%C4%B1%20okudum&url=${encodeURIComponent('https://aitr.blog/blog/' + slug + '/')}`} target="_blank" rel="noopener" class="btn btn-ghost">X'te Paylaş</a>
				</div>
			</div>
		)
	}
</section>

<style>
	.comments-wrap {
		max-width: 760px;
		margin: 3em auto 2em;
		padding: 0 1.25em;
	}
	.comments-head {
		margin-bottom: 1.5em;
		text-align: center;
	}
	.comments-head h2 {
		margin: 0 0 0.3em 0;
		font-size: 1.6em;
	}
	.comments-head p {
		color: var(--text-muted);
		margin: 0;
		font-size: 0.95em;
	}
	.giscus-container {
		min-height: 200px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 14px;
		padding: 1.25em;
	}
	.comments-placeholder {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 14px;
		padding: 2.5em 1.5em;
		text-align: center;
	}
	.ph-icon {
		font-size: 3em;
		margin-bottom: 0.4em;
	}
	.comments-placeholder h3 {
		margin: 0 0 0.4em 0;
		font-size: 1.2em;
	}
	.comments-placeholder p {
		color: var(--text-muted);
		margin: 0 0 1.25em 0;
		font-size: 0.95em;
	}
	.comments-placeholder a {
		color: var(--accent);
	}
	.ph-actions {
		display: flex;
		gap: 0.6em;
		justify-content: center;
		flex-wrap: wrap;
	}
</style>

<script is:inline>
	(function () {
		function syncGiscusTheme() {
			var frame = document.querySelector('iframe.giscus-frame');
			if (!frame) return;
			var theme = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
			frame.contentWindow.postMessage({ giscus: { setConfig: { theme: theme } } }, 'https://giscus.app');
		}
		document.addEventListener('astro:page-load', function () {
			setTimeout(syncGiscusTheme, 1500);
		});
		var observer = new MutationObserver(syncGiscusTheme);
		observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
	})();
</script>
