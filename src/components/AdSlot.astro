---
interface Props {
	size?: 'leaderboard' | 'rectangle' | 'banner' | 'responsive' | 'inline';
	label?: string;
	slot?: string;
}
const { size = 'responsive', label = 'Reklam', slot = '' } = Astro.props;
---

<aside class={`ad-slot ad-slot-${size}`} aria-label="Reklam alanı" data-ad-slot={slot}>
	<span class="ad-label">{label}</span>
	{/* AdSense — onaylandıktan sonra aşağıdaki yorum satırlarını aç ve client ID'yi gir */}
	{/*
	<ins class="adsbygoogle"
		style="display:block"
		data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
		data-ad-slot={slot}
		data-ad-format="auto"
		data-full-width-responsive="true"></ins>
	<script is:inline>
		(adsbygoogle = window.adsbygoogle || []).push({});
	</script>
	*/}
</aside>

<style>
	.ad-slot {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		position: relative;
		margin: 2.5em auto;
		background: var(--surface);
		border: 1px dashed var(--border-2);
		border-radius: 12px;
		overflow: hidden;
		transition: 0.2s ease;
	}
	.ad-label {
		color: var(--text-dim);
		font-size: 0.7em;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		font-weight: 600;
		opacity: 0.7;
	}
	.ad-slot-leaderboard {
		width: 100%;
		max-width: 728px;
		min-height: 90px;
	}
	.ad-slot-banner {
		width: 100%;
		max-width: 970px;
		min-height: 90px;
	}
	.ad-slot-rectangle {
		width: 100%;
		max-width: 336px;
		min-height: 280px;
	}
	.ad-slot-responsive {
		width: 100%;
		max-width: 970px;
		min-height: 120px;
	}
	.ad-slot-inline {
		width: 100%;
		max-width: 100%;
		min-height: 250px;
		margin: 2em 0;
	}
	@media (max-width: 720px) {
		.ad-slot {
			min-height: 100px;
		}
		.ad-slot-leaderboard,
		.ad-slot-banner,
		.ad-slot-responsive {
			min-height: 100px;
		}
		.ad-slot-rectangle,
		.ad-slot-inline {
			min-height: 250px;
		}
	}
</style>
